---
import { getCollection } from "astro:content";
import MainLayout from "../layouts/mainlayout.astro";
import { excerpts } from "../utils/excerptsPaths";

import "../styles/home.css";

import type { CollectionEntry } from "astro:content";

const originals = await getCollection("originals");
const recentOriginals = [...originals]
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

// 精选摘录：从 excerpts/posts（集合名为 posts）读取
const excerptPosts = await getCollection("posts");
const recentExcerpts = [...excerptPosts]
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 4);

const pickExcerptText = (post: CollectionEntry<"posts">) =>
  post.data.description ?? post.data.title ?? "未填写摘录内容";

const pickExcerptSource = (post: CollectionEntry<"posts">) => {
  const author = post.data.author;
  if (typeof author === "string") return author;
  if (author && typeof author === "object") return author.name;
  return post.data.sourceUrl ?? null;
};

const formatDate = (date: Date) => {
  const y = date.getFullYear();
  const m = String(date.getMonth() + 1).padStart(2, "0");
  const d = String(date.getDate()).padStart(2, "0");
  return `${y}.${m}.${d}`;
};

/*
  刊头标题逐字拆分：每个字一个 .hero-char，
  由 --l（行号）与 --i（字序）算出错峰延迟，实现逐字浮现。
  拆在服务端渲染，不需要 JS，也不会出现首帧闪烁。
*/
const heroLines = ["思考、摘录、写作", "在这里交织成网"];
---

<MainLayout
  title="Tourweint/多鸣"
  description="思考、摘录与写作的入口"
  wide={true}
>
  <div class="home-page">
    <section class="hero grid-layout">
      <div class="hero-content">
        <span class="hero-eyebrow">Tourweint / 多鸣</span>
        <h1 class="hero-title">
          {heroLines.map((line, li) => (
            <span class:list={["hero-line", li === 1 && "indent-text"]}>{[...line].map((char, i) => (
              <span class="hero-char" style={`--l:${li}; --i:${i}`}>{char}</span>
            ))}</span>
          ))}
        </h1>
      </div>
    </section>

    <section
      class="originals-section grid-layout"
      aria-labelledby="home-originals-title"
    >
      <div class="section-header">
        <h2 id="home-originals-title">
          <span class="section-num" aria-hidden="true">01</span>
          最新原创
        </h2>
        <a href="/originals" class="more">全部 →</a>
      </div>

      <div class="originals-grid">
        {
          recentOriginals.length > 0 ? (
            recentOriginals.map((post, index) => (
              <a
                href={`/originals/${post.id}`}
                class={index === 0 ? "featured-card" : "standard-card"}
              >
                <div class="card-meta">{formatDate(post.data.pubDate)}</div>
                <h3 class="card-title">{post.data.title}</h3>
                {index === 0 && post.data.description && (
                  <p class="card-desc">{post.data.description}</p>
                )}
                {post.data.tags.length > 0 && (
                  <div class="card-tags">
                    {post.data.tags.slice(0, 2).map((tag) => (
                      <span class="card-tag">{tag}</span>
                    ))}
                  </div>
                )}
              </a>
            ))
          ) : (
            <div class="empty-state">还没有原创文章，敬请期待。</div>
          )
        }
      </div>
    </section>

    <section class="excerpts-section" aria-labelledby="home-excerpts-title">
      <div class="grid-layout">
        <div class="section-header section-header--compact">
          <h2 id="home-excerpts-title">
            <span class="section-num" aria-hidden="true">02</span>
            精选摘录
          </h2>
          <a class="more" href={excerpts.postsIndex}>全部 →</a>
        </div>
      </div>

      {
        recentExcerpts.length > 0 ? (
          <div class="excerpt-waterfall">
            {recentExcerpts.map((post) => {
              const excerpt = pickExcerptText(post);
              const source = pickExcerptSource(post);
              return (
                <article class="excerpt-item">
                  <p class="excerpt-text">“{excerpt}”</p>
                  <div class="excerpt-meta">
                    <span class="excerpt-date">
                      {formatDate(post.data.pubDate)}
                    </span>
                    {source && <cite class="excerpt-cite">— {source}</cite>}
                  </div>
                </article>
              );
            })}
          </div>
        ) : (
          <div class="grid-layout">
            <div class="empty-state">还没有摘录内容，继续创作中。</div>
          </div>
        )
      }
    </section>

  </div>
</MainLayout>
