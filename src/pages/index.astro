---
import "../styles/home.css";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import MainLayout from "../layouts/mainlayout.astro";
import { excerpts } from "../utils/excerptsPaths";

const posts = await getCollection("posts");
posts.sort(
  (a: CollectionEntry<"posts">, b: CollectionEntry<"posts">) =>
    b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const recentOriginals = posts.slice(0, 3);

const notes = await getCollection("notes");
const resolveNoteDate = (note: CollectionEntry<"notes">) =>
  note.data.pubDate ?? note.data.date ?? null;
const recentExcerpts = [...notes]
  .sort((a, b) => {
    const aDate = resolveNoteDate(a)?.getTime() ?? 0;
    const bDate = resolveNoteDate(b)?.getTime() ?? 0;
    return bDate - aDate;
  })
  .slice(0, 4);

const pickExcerptText = (note: CollectionEntry<"notes">) =>
  note.data.description ??
  note.data.text ??
  note.data.title ??
  "未填写摘录内容";
const formatDate = (date: Date | null) =>
  date ? date.toLocaleDateString("zh-cn") : "未标注日期";
---

<MainLayout
  title="Tourweint/多鸣"
  description="思考、摘录与写作的入口"
  wide={true}
>
  <div class="home-page">
    <section class="hero">
      <div class="hero-container">
        <div class="hero-eyebrow">欢迎来到我的思考空间</div>
        <h1 class="hero-title">
          思考、摘录、写作<br />在这里交织成网
        </h1>
        <p class="hero-sub">
          我记录对世界的理解，以及思考的过程。每一篇文章、每一条摘录，都是我在认真打磨的作品。
        </p>
        <div class="hero-cta">
          <a href="/originals" class="cta-button primary">探索原创文章</a>
          <a href={excerpts.notesIndex} class="cta-button secondary">
            阅读摘录笔记
          </a>
        </div>
      </div>
    </section>

    <section class="originals-section">
      <div class="section-heading">
        <div>
          <h2>最新原创文章</h2>
          <p class="section-subtitle">我的思考与写作</p>
        </div>
        <a class="view-all-link" href="/originals">查看全部 →</a>
      </div>
      <div class="originals-list">
        {
          recentOriginals.length > 0 ? (
            recentOriginals.map((post) => (
              <a href={excerpts.postDetail(post.id)} class="original-card">
                <div class="original-header">
                  <div class="original-title">{post.data.title}</div>
                  <div class="original-meta">
                    <span class="original-date">
                      {post.data.pubDate.toLocaleDateString("zh-cn")}
                    </span>
                  </div>
                </div>
                {post.data.description && (
                  <p class="original-desc">{post.data.description}</p>
                )}
                {post.data.tags && post.data.tags.length > 0 && (
                  <div class="original-tags">
                    {post.data.tags.slice(0, 3).map((tag: string) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                )}
              </a>
            ))
          ) : (
            <div class="empty-state">还没有原创文章，敬请期待。</div>
          )
        }
      </div>
    </section>

    <section class="excerpts-section">
      <div class="section-heading">
        <div>
          <h2>精选摘录与笔记</h2>
          <p class="section-subtitle">他人智慧的镜像</p>
        </div>
        <a class="view-all-link" href={excerpts.notesIndex}>查看全部 →</a>
      </div>
      <div class="excerpt-grid">
        {
          recentExcerpts.length > 0 ? (
            recentExcerpts.map((note) => {
              const date = resolveNoteDate(note);
              const excerpt = pickExcerptText(note);
              return (
                <article class="excerpt-card">
                  <div class="excerpt-header">
                    <span class="badge">摘录</span>
                    <span class="excerpt-date">{formatDate(date)}</span>
                  </div>
                  <div class="excerpt-text">{excerpt}</div>
                  {note.data.source && (
                    <div class="excerpt-source">—— {note.data.source}</div>
                  )}
                </article>
              );
            })
          ) : (
            <div class="empty-state">还没有摘录笔记，继续创作中。</div>
          )
        }
      </div>
    </section>

    <section class="explore-section\">
      <div class='\"section-heading\"'>
        <h2>继续探索</h2>
      </div>
      <div class='\"explore-grid\"'>
        <a class="explore-card" href="/originals">
          <h3>去看我的原创 →</h3>
          <p>最新文章、写作与思考的全量列表。</p>
        </a>
        <a class="explore-card" href={excerpts.notesIndex}>
          <h3>浏览摘录 →</h3>
          <p>我正在消化的片段、旁注和灵感。</p>
        </a>
        <a class="explore-card" href={excerpts.categoryIndex}>
          <h3>按主题阅读 →</h3>
          <p>按主题快速筛选，直达你关心的话题。</p>
        </a>
      </div>
    </section>
  </div>
</MainLayout>
