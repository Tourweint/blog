---
import "../styles/index.css";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import MainLayout from "../layouts/mainlayout.astro";

const posts = await getCollection("posts");
posts.sort(
  (a: CollectionEntry<"posts">, b: CollectionEntry<"posts">) =>
    b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const categories = [
  "全部",
  ...new Set(
    posts.flatMap((p) => (p.data.tags?.length ? p.data.tags : ["未分类"]))
  ),
];
---

<MainLayout
  title="大音希声，大象无形。"
  description="多鸣的个人博客"
  wide={true}
>
  <div class="app-container">
    <aside>
      <div class="profile-card">
        <div class="avatar"></div>
        <div class="profile-name">多鸣的博客</div>
        <div class="profile-bio">多元发声，掷地有声</div>
        <div class="profile-bio">心有热爱，必有回响</div>
      </div>

      <nav class="category-nav">
        <div class="nav-title">文章分类</div>
        <div id="category-list">
          {
            categories.map((cat) => {
              const count =
                cat === "全部"
                  ? posts.length
                  : posts.filter((p) => p.data.tags?.includes(cat)).length;
              return (
                <button
                  class={`filter-btn${cat === "全部" ? " active" : ""}`}
                  data-category={cat}
                >
                  <span>{cat}</span>
                  <span class="category-badge">{count}</span>
                </button>
              );
            })
          }
        </div>
      </nav>
    </aside>

    <main>
      <h2 id="list-title">最新文章</h2>
      {
        posts.length > 0 ? (
          <div class="post-grid">
            {posts.map((post: CollectionEntry<"posts">) => (
              <a
                href={`/posts/${post.slug}`}
                class="post-card-link"
                data-title={post.data.title.toLowerCase()}
                data-desc={(post.data.description || "").toLowerCase()}
                data-tags={(post.data.tags || ["未分类"])
                  .join(",")
                  .toLowerCase()}
              >
                <article class="post-card">
                  <div class="card-meta">
                    <span>{post.data.pubDate.toLocaleDateString("zh-cn")}</span>
                    <div class="card-tags">
                      {post.data.tags?.map((t: string) => (
                        <span class="card-tag">{t}</span>
                      ))}
                    </div>
                  </div>
                  <h3 class="post-title">{post.data.title}</h3>
                  {post.data.description && (
                    <p class="post-desc">{post.data.description}</p>
                  )}
                  <span class="read-more">阅读全文 →</span>
                </article>
              </a>
            ))}
          </div>
        ) : (
          <div class="no-results">
            暂无文章，请在 <code>src/content/posts</code> 中添加 Markdown 文件。
          </div>
        )
      }
      <div class="no-results" id="filter-no-results" style="display: none;">
        未找到符合条件的文章，尝试调整搜索或分类。
      </div>

      <div
        id="pagination-controls"
        class="pagination-container"
        style="display: none;"
      >
        <button id="first-btn" class="page-btn" aria-label="第一页" disabled>
          ⏮
        </button>
        <button id="prev-btn" class="page-btn" aria-label="上一页" disabled>
          ◀
        </button>
        <span id="page-info">1/1</span>
        <button id="next-btn" class="page-btn" aria-label="下一页">▶</button>
        <button id="last-btn" class="page-btn" aria-label="最后一页">⏭</button>
      </div>
    </main>
  </div>
</MainLayout>

<script>
  {
    const categoryList = document.getElementById("category-list");
    const listTitle = document.getElementById("list-title");
    const noResults = document.getElementById("filter-no-results");

    // 分页相关 DOM
    const paginationControls = document.getElementById("pagination-controls");
    const prevBtn = document.getElementById("prev-btn");
    const nextBtn = document.getElementById("next-btn");
    const firstBtn = document.getElementById("first-btn");
    const lastBtn = document.getElementById("last-btn");
    const pageInfo = document.getElementById("page-info");

    const cards = document.querySelectorAll(".post-card-link");

    if (
      categoryList &&
      listTitle &&
      noResults &&
      paginationControls &&
      prevBtn &&
      nextBtn &&
      firstBtn &&
      lastBtn &&
      pageInfo
    ) {
      // 状态变量
      let activeCategory = "全部";

      // 分页变量
      const itemsPerPage = 8; // 每页显示 10 篇
      let currentPage = 1;
      let visibleCards: HTMLElement[] = []; // 存储当前符合筛选条件的所有卡片

      // 更新分页 UI
      const updatePaginationUI = () => {
        const totalItems = visibleCards.length;
        const totalPages = Math.ceil(totalItems / itemsPerPage);

        // 如果没有内容或者只有一页，隐藏分页控件
        if (totalPages <= 1) {
          paginationControls.style.display = "none";
        } else {
          paginationControls.style.display = "flex";
          pageInfo.textContent = `${currentPage}/${totalPages}`;

          // 设置按钮状态
          const prevEl = prevBtn as HTMLButtonElement;
          const nextEl = nextBtn as HTMLButtonElement;
          const firstEl = firstBtn as HTMLButtonElement;
          const lastEl = lastBtn as HTMLButtonElement;

          prevEl.disabled = currentPage === 1;
          firstEl.disabled = currentPage === 1;
          nextEl.disabled = currentPage === totalPages;
          lastEl.disabled = currentPage === totalPages;
        }
      };

      // 渲染当前页的文章
      const renderCurrentPage = () => {
        // 先隐藏所有卡片
        cards.forEach((c) => ((c as HTMLElement).style.display = "none"));

        // 计算当前页的起始和结束索引
        const startIndex = (currentPage - 1) * itemsPerPage;
        const endIndex = startIndex + itemsPerPage;

        // 获取当前页应该显示的卡片
        const cardsToShow = visibleCards.slice(startIndex, endIndex);

        // 显示这些卡片
        cardsToShow.forEach((card) => (card.style.display = ""));

        // 更新按钮状态
        updatePaginationUI();

        // 滚动回顶部（可选，体验更好）
        if (window.scrollY > 200) {
          document
            .querySelector("main")
            ?.scrollIntoView({ behavior: "smooth" });
        }
      };

      // 核心筛选函数
      const applyFilter = (resetPage = true) => {
        // 如果是新的分类，重置回第一页
        if (resetPage) currentPage = 1;

        visibleCards = []; // 清空之前的筛选结果

        // 找出所有符合条件的卡片
        cards.forEach((card) => {
          if (!(card instanceof HTMLElement)) return;

          const tags = card.dataset.tags || "";

          const matchCategory =
            activeCategory === "全部" ||
            tags.includes(activeCategory.toLowerCase());

          if (matchCategory) {
            visibleCards.push(card);
          }
        });

        // 更新无结果提示
        noResults.style.display =
          visibleCards.length === 0 && activeCategory !== "全部"
            ? "block"
            : "none";

        listTitle.textContent =
          activeCategory !== "全部" ? activeCategory : "最新文章";

        // 执行分页渲染
        renderCurrentPage();
      };

      // 绑定分页按钮事件
      prevBtn.addEventListener("click", () => {
        if (currentPage > 1) {
          currentPage--;
          renderCurrentPage();
        }
      });

      nextBtn.addEventListener("click", () => {
        const totalPages = Math.ceil(visibleCards.length / itemsPerPage);
        if (currentPage < totalPages) {
          currentPage++;
          renderCurrentPage();
        }
      });

      firstBtn.addEventListener("click", () => {
        if (currentPage !== 1) {
          currentPage = 1;
          renderCurrentPage();
        }
      });

      lastBtn.addEventListener("click", () => {
        const totalPages = Math.ceil(visibleCards.length / itemsPerPage);
        if (currentPage !== totalPages) {
          currentPage = totalPages;
          renderCurrentPage();
        }
      });

      // 绑定分类点击事件
      categoryList.addEventListener("click", (event) => {
        const target = event.target as HTMLElement;
        const button = target.closest(".filter-btn") as HTMLElement | null;

        if (!button || !button.dataset.category) return;

        activeCategory = button.dataset.category;

        const buttons = categoryList.querySelectorAll(".filter-btn");
        buttons.forEach((btn) => btn.classList.remove("active"));
        button.classList.add("active");

        applyFilter(true); // 切换分类时重置页码
      });

      // 初始化
      applyFilter();
    }
  }
</script>
