---
import MainLayout from "../../../layouts/mainlayout.astro";
import "../../../styles/tools.css";

const getFavicon = (url: string): string => {
  try {
    const hostname = new URL(url).hostname;
    return `https://www.google.com/s2/favicons?sz=64&domain=${hostname}`;
  } catch {
    return "";
  }
};

const tools = [
  {
    category: "开发工具",
    items: [
      {
        name: "VS Code",
        description: "强大的代码编辑器，支持丰富的扩展生态",
        icon: "https://www.google.com/s2/favicons?sz=64&domain=code.visualstudio.com", // 填写图标链接，如 "/image/tools/vscode.png" 或网络链接
        url: "https://code.visualstudio.com/",
      },
    ],
  },
  {
    category: "设计与创作",
    items: [
      {
        name: "Figma",
        description: "在线协作设计工具",
        icon: "",
        url: "https://www.figma.com/",
      },
      {
        name: "Canva",
        description: "简单易用的图形设计平台",
        icon: "",
        url: "https://www.canva.com/",
      },
      {
        name: "Excalidraw",
        description: "手绘风格的白板绘图工具",
        icon: "",
        url: "https://excalidraw.com/",
      },
    ],
  },
  {
    category: "效率工具",
    items: [
      {
        name: "Notion",
        description: "一体化的笔记与协作工具",
        icon: "",
        url: "https://www.notion.so/",
      },
      {
        name: "Ghostwriter",
        description: "专注 Markdown 文档查看与写作的轻量编辑器",
        icon: "",
        url: "https://ghostwriter.kde.org/",
      },
      {
        name: "Obsidian",
        description: "本地优先的知识库构建工具",
        icon: "",
        url: "https://obsidian.md/",
      },
      {
        name: "Raycast",
        description: "高效的启动器和生产力工具",
        icon: "",
        url: "https://www.raycast.com/",
      },
    ],
  },
  {
    category: "AI 工具",
    items: [
      {
        name: "智谱 AI 输入法",
        description: "集成大模型能力的输入法，支持写作/润色/改写等",
        icon: "",
        url: "https://autoglm.zhipuai.cn/autotyper",
      },
      {
        name: "OpenCode",
        description: "面向编码场景的智能编程助手/工作流工具",
        icon: "",
        url: "https://opencode.ai/",
      },
      {
        name: "GitHub Copilot",
        description: "AI 驱动的代码补全工具",
        icon: "",
        url: "https://github.com/features/copilot",
      },
    ],
  },
  {
    category: "浏览器扩展",
    items: [
      {
        name: "uBlock Origin",
        description: "高效的广告拦截器",
        icon: "",
        url: "https://ublockorigin.com/",
      },
      {
        name: "沉浸式翻译",
        description: "双语对照网页翻译扩展",
        icon: "",
        url: "https://immersivetranslate.com/",
      },
      {
        name: "Vimium",
        description: "键盘驱动的浏览器操作",
        icon: "",
        url: "https://vimium.github.io/",
      },
    ],
  },
];

const totalTools = tools.reduce(
  (sum, category) => sum + category.items.length,
  0,
);
---

<MainLayout title="工具箱 - Tourweint/多鸣">
  <div class="tools-container">
    <header class="tools-header">
      <p class="eyebrow">Tools</p>
      <h1 class="tools-title">工具箱</h1>
      <p class="tools-subtitle">这里收集了我日常使用的各类工具。</p>
      <div class="tools-meta" aria-label="工具箱摘要">
        <span class="meta-item">共 {tools.length} 类</span>
        <span class="meta-sep" aria-hidden="true">·</span>
        <span class="meta-item">{totalTools} 个工具</span>
        <span class="meta-sep" aria-hidden="true">·</span>
        <a class="meta-link" href="/about/about">关于我</a>
      </div>
    </header>

    <div class="tools-grid">
      {
        tools.map((category, index) => {
          const previewItems = category.items.slice(0, 3);
          const hiddenItems = category.items.slice(3);
          const hasMore = hiddenItems.length > 0;

          return (
            <section class="tool-category">
              <div class="category-header">
                <h2 class="category-title">{category.category}</h2>
                <span class="category-count">
                  {category.items.length} 个工具
                </span>
                {hasMore && (
                  <button
                    class="expand-tools-btn"
                    type="button"
                    data-expanded="false"
                    aria-expanded="false"
                    aria-controls={`hidden-tools-${index}`}
                  >
                    展开 +{hiddenItems.length}
                  </button>
                )}
              </div>
              <div class="tool-list">
                {previewItems.map((tool) => {
                  const iconUrl = tool.icon || getFavicon(tool.url);
                  return (
                    <a
                      href={tool.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="tool-card"
                    >
                      <div class="tool-icon-wrapper" aria-hidden="true">
                        {iconUrl ? (
                          <img
                            src={iconUrl}
                            alt=""
                            class="tool-icon"
                            loading="lazy"
                          />
                        ) : (
                          <span class="tool-icon-placeholder">
                            {tool.name.charAt(0)}
                          </span>
                        )}
                      </div>
                      <div class="tool-info">
                        <h3 class="tool-name">{tool.name}</h3>
                        <p class="tool-desc">{tool.description}</p>
                      </div>
                      <span class="tool-arrow" aria-hidden="true">
                        →
                      </span>
                    </a>
                  );
                })}

                {hasMore && (
                  <div class="hidden-tools" id={`hidden-tools-${index}`} hidden>
                    {hiddenItems.map((tool) => {
                      const iconUrl = tool.icon || getFavicon(tool.url);
                      return (
                        <a
                          href={tool.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="tool-card"
                        >
                          <div class="tool-icon-wrapper" aria-hidden="true">
                            {iconUrl ? (
                              <img
                                src={iconUrl}
                                alt=""
                                class="tool-icon"
                                loading="lazy"
                              />
                            ) : (
                              <span class="tool-icon-placeholder">
                                {tool.name.charAt(0)}
                              </span>
                            )}
                          </div>
                          <div class="tool-info">
                            <h3 class="tool-name">{tool.name}</h3>
                            <p class="tool-desc">{tool.description}</p>
                          </div>
                          <span class="tool-arrow" aria-hidden="true">
                            →
                          </span>
                        </a>
                      );
                    })}
                  </div>
                )}
              </div>
            </section>
          );
        })
      }
    </div>
  </div>
</MainLayout>

<script>
  // 工具展开/收起功能（每个分类块）
  document.querySelectorAll(".expand-tools-btn").forEach((button) => {
    button.addEventListener("click", () => {
      const expanded = button.getAttribute("data-expanded") === "true";
      button.setAttribute("data-expanded", String(!expanded));
      button.setAttribute("aria-expanded", String(!expanded));

      const listId = button.getAttribute("aria-controls");
      const hiddenTools = listId ? document.getElementById(listId) : null;
      if (hiddenTools) {
        hiddenTools.toggleAttribute("hidden", expanded);
      }

      const hiddenCount = hiddenTools
        ? hiddenTools.querySelectorAll(".tool-card").length
        : 0;
      button.textContent = expanded ? `展开 +${hiddenCount}` : "收起";
    });
  });

  // 图标加载失败时显示占位符
  document.querySelectorAll(".tool-icon").forEach((img) => {
    img.addEventListener("error", () => {
      const wrapper = img.parentElement;
      const toolCard = img.closest(".tool-card");
      const toolName =
        toolCard?.querySelector(".tool-name")?.textContent || "?";
      if (wrapper) {
        const placeholder = document.createElement("span");
        placeholder.className = "tool-icon-placeholder";
        placeholder.textContent = toolName.charAt(0);
        wrapper.replaceChild(placeholder, img);
      }
    });
  });
</script>
