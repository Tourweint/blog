---
import MainLayout from "../../../layouts/mainlayout.astro";
import "../../../styles/tools.css";

const tools = [
  {
    category: "开发工具",
    items: [
      {
        name: "VS Code",
        description: "强大的代码编辑器，支持丰富的扩展生态",
        icon: "https://www.google.com/s2/favicons?sz=64&domain=code.visualstudio.com", // 填写图标链接，如 "/image/tools/vscode.png" 或网络链接
        url: "https://code.visualstudio.com/",
      },
      {
        name: "GitHub",
        description: "代码托管与版本控制平台",
        icon: "",
        url: "https://github.com/",
      },
      {
        name: "Git",
        description: "分布式版本控制系统",
        icon: "",
        url: "https://git-scm.com/",
      },
      {
        name: "Node.js",
        description: "JavaScript 运行时环境",
        icon: "",
        url: "https://nodejs.org/",
      },
    ],
  },
  {
    category: "设计与创作",
    items: [
      {
        name: "Figma",
        description: "在线协作设计工具",
        icon: "",
        url: "https://www.figma.com/",
      },
      {
        name: "Canva",
        description: "简单易用的图形设计平台",
        icon: "",
        url: "https://www.canva.com/",
      },
      {
        name: "Excalidraw",
        description: "手绘风格的白板绘图工具",
        icon: "",
        url: "https://excalidraw.com/",
      },
    ],
  },
  {
    category: "效率工具",
    items: [
      {
        name: "Notion",
        description: "一体化的笔记与协作工具",
        icon: "",
        url: "https://www.notion.so/",
      },
      {
        name: "Obsidian",
        description: "本地优先的知识管理工具",
        icon: "",
        url: "https://obsidian.md/",
      },
      {
        name: "Raycast",
        description: "高效的启动器和生产力工具",
        icon: "",
        url: "https://www.raycast.com/",
      },
    ],
  },
  {
    category: "AI 工具",
    items: [
      {
        name: "ChatGPT",
        description: "OpenAI 的对话式 AI 助手",
        icon: "",
        url: "https://chat.openai.com/",
      },
      {
        name: "GitHub Copilot",
        description: "AI 驱动的代码补全工具",
        icon: "",
        url: "https://github.com/features/copilot",
      },
      {
        name: "Claude",
        description: "Anthropic 的 AI 助手",
        icon: "",
        url: "https://claude.ai/",
      },
    ],
  },
  {
    category: "浏览器扩展",
    items: [
      {
        name: "uBlock Origin",
        description: "高效的广告拦截器",
        icon: "",
        url: "https://ublockorigin.com/",
      },
      {
        name: "沉浸式翻译",
        description: "双语对照网页翻译扩展",
        icon: "",
        url: "https://immersivetranslate.com/",
      },
      {
        name: "Vimium",
        description: "键盘驱动的浏览器操作",
        icon: "",
        url: "https://vimium.github.io/",
      },
    ],
  },
];
---

<MainLayout title="工具箱 - Tourweint/多鸣">
  <div class="tools-page-bg">
    <div class="tools-container">
      <header class="tools-header">
        <h1>🧰 我的工具箱</h1>
        <p class="tools-subtitle">
          这里收集了我日常使用的各类工具，希望对你有所帮助
        </p>
      </header>

      <div class="tools-grid">
        {
          tools.map((category, index) => {
            const visibleItems = category.items.slice(0, 3);
            const hiddenItems = category.items.slice(3);
            const hasMore = hiddenItems.length > 0;

            return (
              <section class="tool-category">
                <button
                  class="category-header"
                  data-expanded="true"
                  aria-expanded="true"
                  aria-controls={`tool-list-${index}`}
                >
                  <h2 class="category-title">{category.category}</h2>
                  <span class="category-count">
                    {category.items.length} 个工具
                  </span>
                  <span class="category-toggle">▼</span>
                </button>
                <div class="tool-list" id={`tool-list-${index}`}>
                  {visibleItems.map((tool) => (
                    <a
                      href={tool.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="tool-card"
                    >
                      <div class="tool-icon-wrapper">
                        {tool.icon ? (
                          <img
                            src={tool.icon}
                            alt={tool.name}
                            class="tool-icon"
                            loading="lazy"
                          />
                        ) : (
                          <span class="tool-icon-placeholder">
                            {tool.name.charAt(0)}
                          </span>
                        )}
                      </div>
                      <div class="tool-info">
                        <h3 class="tool-name">{tool.name}</h3>
                        <p class="tool-desc">{tool.description}</p>
                      </div>
                      <span class="tool-arrow">→</span>
                    </a>
                  ))}

                  {hasMore && (
                    <div class="hidden-tools" data-hidden="true">
                      {hiddenItems.map((tool) => (
                        <a
                          href={tool.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="tool-card"
                        >
                          <div class="tool-icon-wrapper">
                            {tool.icon ? (
                              <img
                                src={tool.icon}
                                alt={tool.name}
                                class="tool-icon"
                                loading="lazy"
                              />
                            ) : (
                              <span class="tool-icon-placeholder">
                                {tool.name.charAt(0)}
                              </span>
                            )}
                          </div>
                          <div class="tool-info">
                            <h3 class="tool-name">{tool.name}</h3>
                            <p class="tool-desc">{tool.description}</p>
                          </div>
                          <span class="tool-arrow">→</span>
                        </a>
                      ))}
                    </div>
                  )}
                </div>

                {hasMore && (
                  <button class="expand-tools-btn" data-expanded="false">
                    <span class="expand-text">
                      展开剩余 {hiddenItems.length} 个工具
                    </span>
                    <span class="expand-icon">▼</span>
                  </button>
                )}
              </section>
            );
          })
        }
      </div>
    </div>
  </div>
</MainLayout>

<script>
  // 分类展开/收起功能
  document.querySelectorAll(".category-header").forEach((button) => {
    button.addEventListener("click", () => {
      const expanded = button.getAttribute("data-expanded") === "true";
      button.setAttribute("data-expanded", String(!expanded));
      button.setAttribute("aria-expanded", String(!expanded));

      const toolList = button.nextElementSibling as HTMLElement;
      if (toolList) {
        toolList.style.display = expanded ? "none" : "grid";
      }

      // 同时隐藏/显示展开按钮
      const expandBtn = button
        .closest(".tool-category")
        ?.querySelector(".expand-tools-btn") as HTMLElement;
      if (expandBtn) {
        expandBtn.style.display = expanded ? "none" : "flex";
      }
    });
  });

  // 工具展开/收起功能
  document.querySelectorAll(".expand-tools-btn").forEach((button) => {
    button.addEventListener("click", () => {
      const expanded = button.getAttribute("data-expanded") === "true";
      button.setAttribute("data-expanded", String(!expanded));

      const hiddenTools = button.previousElementSibling?.querySelector(
        ".hidden-tools",
      ) as HTMLElement;
      if (hiddenTools) {
        hiddenTools.setAttribute("data-hidden", String(expanded));
      }

      const expandText = button.querySelector(".expand-text");
      const hiddenCount =
        hiddenTools?.querySelectorAll(".tool-card").length || 0;
      if (expandText) {
        expandText.textContent = expanded
          ? `展开剩余 ${hiddenCount} 个工具`
          : "收起";
      }
    });
  });

  // 图标加载失败时显示占位符
  document.querySelectorAll(".tool-icon").forEach((img) => {
    img.addEventListener("error", () => {
      const wrapper = img.parentElement;
      const toolName = img.getAttribute("alt") || "?";
      if (wrapper) {
        const placeholder = document.createElement("span");
        placeholder.className = "tool-icon-placeholder";
        placeholder.textContent = toolName.charAt(0);
        wrapper.replaceChild(placeholder, img);
      }
    });
  });
</script>
