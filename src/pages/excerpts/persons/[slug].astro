---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import MainLayout from "../../../layouts/mainlayout.astro";
import { excerpts } from "../../../utils/excerptsPaths";
import "../../../styles/persons.css";

export const toSlug = (id: string) => id.replace(/\.(md|mdx)$/i, "");

export async function getStaticPaths() {
  const persons = await getCollection("persons");
  const conversations = await getCollection("conversations");

  return persons.map((person) => {
    const personSlug = toSlug(person.id);
    const relatedConversations = conversations.filter(
      (c) =>
        c.data.guests.includes(personSlug) || c.data.interviewer === personSlug,
    );

    return {
      params: { slug: personSlug },
      props: { person, relatedConversations },
    };
  });
}

interface Props {
  person: CollectionEntry<"persons">;
  relatedConversations: CollectionEntry<"conversations">[];
}

const { person, relatedConversations } = Astro.props;
const { data } = person;
const { Content } = await render(person);

const sortedConversations = relatedConversations.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
---

<MainLayout
  title={`${data.name} - 人物志`}
  description={data.bio || `关于 ${data.name} 的介绍`}
  image={data.avatar}
>
  <article class="person-detail">
    <div class="person-detail-container">
      <nav class="back-nav">
        <a href={excerpts.personsIndex} class="back-link">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="back-icon"
          >
            <path d="M19 12H5M12 19l-7-7 7-7"></path>
          </svg>
          返回人物志
        </a>
      </nav>
      <header class="person-header">
        {
          data.avatar && (
            <img
              src={data.avatar}
              alt={data.name}
              class="avatar-large"
              loading="lazy"
            />
          )
        }
        <h1>{data.name}</h1>
        {
          data.nameEn && data.nameEn !== data.name && (
            <span class="name-en">{data.nameEn}</span>
          )
        }
        {data.role && <p class="role">{data.role}</p>}

        {
          data.tags && data.tags.length > 0 && (
            <div class="tags">
              {data.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          )
        }

        {data.bio && <p class="person-bio-summary">{data.bio}</p>}

        {
          data.links && (
            <div class="person-links">
              {data.links.website && (
                <a
                  href={data.links.website}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <svg
                    class="link-icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <circle cx="12" cy="12" r="10" />
                    <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                  </svg>
                  网站
                </a>
              )}
              {data.links.twitter && (
                <a
                  href={data.links.twitter}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <svg
                    class="link-icon"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                  >
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                  </svg>
                  Twitter
                </a>
              )}
              {data.links.github && (
                <a
                  href={data.links.github}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <svg
                    class="link-icon"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                  >
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                  </svg>
                  GitHub
                </a>
              )}
              {data.links.linkedin && (
                <a
                  href={data.links.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <svg
                    class="link-icon"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                  >
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                  </svg>
                  LinkedIn
                </a>
              )}
            </div>
          )
        }
      </header>

      <div class="person-content">
        <div class="markdown-body">
          <Content />
        </div>
      </div>

      {
        sortedConversations.length > 0 && (
          <section class="related-conversations">
            <h2>相关对话</h2>
            <div class="related-list">
              {sortedConversations.map((conv) => (
                <a
                  href={excerpts.conversationDetail(conv.id)}
                  class="related-item"
                >
                  <div class="title">{conv.data.title}</div>
                  <div class="meta">
                    <span>{conv.data.source}</span>
                    <time>
                      {new Date(conv.data.pubDate).toLocaleDateString("zh-CN")}
                    </time>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )
      }
    </div>
  </article>
</MainLayout>
