---
import MainLayout from "../../../layouts/mainlayout.astro";
import ChannelHero from "../../../components/ChannelHero.astro";
import ExcerptsTabs from "../../../components/excerpts/ExcerptsTabs.astro";
import ExcerptsAside from "../../../components/excerpts/ExcerptsAside.astro";
import "../../../styles/persons.css";
import "../../../styles/excerpts-aside.css";
import { getCollection } from "astro:content";
import PersonCard from "../../../components/PersonCard.astro";

const persons = (await getCollection("persons")).sort((a, b) => {
  if (a.data.featured !== b.data.featured) {
    return a.data.featured ? -1 : 1;
  }
  return a.data.name.localeCompare(b.data.name, "zh-CN");
});

const tagCounts = new Map<string, number>();
for (const person of persons) {
  for (const tag of person.data.tags ?? []) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}

const allTags = [
  "全部",
  ...[...tagCounts.keys()].sort((a, b) => a.localeCompare(b, "zh-CN")),
];

const ITEMS_PER_PAGE = 12;
---

<MainLayout
  title="人物志 - Tourweint/多鸣"
  description="广泛收录各领域的人物，包括科技领袖、思想家、企业家、博主等"
>
<main class="channel-page">
  <ChannelHero title="人物">
    <span slot="meta">
      <span class="meta-item">共 {persons.length} 位</span>
    </span>
  </ChannelHero>

  <ExcerptsTabs active="persons" />

  <div class="excerpts-layout">
    <ExcerptsAside title="领域" unit={`${allTags.length - 1} 个`}>
      {
        allTags.map((tag) => (
          <button
            class={`aside-item${tag === "全部" ? " is-active" : ""}`}
            type="button"
            data-tag={tag}
            aria-pressed={tag === "全部" ? "true" : "false"}
          >
            <span class="aside-item__label">{tag}</span>
            <span class="aside-item__count">
              {tag === "全部"
                ? persons.length
                : persons.filter((p) => (p.data.tags ?? []).includes(tag)).length}
            </span>
          </button>
        ))
      }
    </ExcerptsAside>

    <div class="excerpts-main">
      <div class="persons-grid" id="persons-grid">
        {
          persons.map((person) => (
            <div
              class="person-item"
              data-tags={(person.data.tags ?? []).join(",")}
            >
              <PersonCard person={person} />
            </div>
          ))
        }
      </div>

      <div class="empty-state" id="empty-state" style="display: none;">
        <p>暂无人物，敬请期待。</p>
      </div>

      <div
        class="load-more-container"
        id="load-more-container"
        style="display: none;"
      >
        <button class="load-more-btn" id="load-more">加载更多</button>
      </div>
    </div>
  </div>
</main>
</MainLayout>

<script is:inline define:vars={{ ITEMS_PER_PAGE, totalPersons: persons.length }}
>
  const pills = Array.from(
    document.querySelectorAll(".aside-item[data-tag]"),
  );
  const items = Array.from(document.querySelectorAll(".person-item"));
  const loadMoreBtn = document.getElementById("load-more");
  const loadMoreContainer = document.getElementById("load-more-container");
  const emptyState = document.getElementById("empty-state");
  const grid = document.getElementById("persons-grid");

  let activeTag = "全部";
  let displayedCount = ITEMS_PER_PAGE;

  // 筛选切换过渡：模块脚本可能晚于本脚本加载，调用时才取
  const withFilterTransition = (fn) =>
    window.runFilterTransition ? window.runFilterTransition(fn) : fn();

  const applyFilter = () => {
    items.forEach((item) => {
      const tags = (item.dataset.tags || "").split(",").filter(Boolean);
      const visible = activeTag === "全部" || tags.includes(activeTag);
      item.style.display = visible ? "" : "none";
    });
    displayedCount = ITEMS_PER_PAGE;
    updatePagination();
  };

  const updatePagination = () => {
    const visibleItems = items.filter((item) => item.style.display !== "none");

    visibleItems.forEach((item, index) => {
      item.style.display = index < displayedCount ? "" : "none";
    });

    if (visibleItems.length > displayedCount) {
      loadMoreContainer.style.display = "block";
    } else {
      loadMoreContainer.style.display = "none";
    }

    if (visibleItems.length === 0) {
      grid.style.display = "none";
      emptyState.style.display = "block";
    } else {
      grid.style.display = "grid";
      emptyState.style.display = "none";
    }
  };

  pills.forEach((pill) => {
    pill.addEventListener("click", () => {
      withFilterTransition(() => {
        pills.forEach((p) => {
          p.classList.remove("is-active");
          p.setAttribute("aria-pressed", "false");
        });
        pill.classList.add("is-active");
        pill.setAttribute("aria-pressed", "true");
        activeTag = pill.dataset.tag || "全部";
        applyFilter();
      });
    });
  });

  loadMoreBtn?.addEventListener("click", () => {
    displayedCount += ITEMS_PER_PAGE;
    updatePagination();
  });

  updatePagination();
</script>
