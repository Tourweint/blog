---
import MainLayout from "../../../layouts/mainlayout.astro";
import ChannelHero from "../../../components/ChannelHero.astro";
import ExcerptsTabs from "../../../components/excerpts/ExcerptsTabs.astro";
import ExcerptsAside from "../../../components/excerpts/ExcerptsAside.astro";
import "../../../styles/conversations.css";
import "../../../styles/excerpts-aside.css";
import { getCollection } from "astro:content";
import ConversationCard from "../../../components/ConversationCard.astro";

const conversations = (await getCollection("conversations")).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

// 提取所有话题标签（带条目数）
const tagCounts = new Map<string, number>();
for (const conversation of conversations) {
  for (const tag of conversation.data.tags ?? []) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}

const allTags = [
  "全部",
  ...[...tagCounts.keys()].sort((a, b) => a.localeCompare(b, "zh-CN")),
];

// 分页设置
const ITEMS_PER_PAGE = 12;
const paginatedConversations = conversations.slice(0, ITEMS_PER_PAGE);
---

<MainLayout
  title="对话 - Tourweint/多鸣"
  description="真实访谈与虚构对话并行，为学习与思考提供灵感"
>
<main class="channel-page">
  <ChannelHero title="对话">
    <span slot="meta">
      <span class="meta-item">共 {conversations.length} 篇</span>
    </span>
  </ChannelHero>

  <ExcerptsTabs active="conversations" />

  <div class="excerpts-layout">
    <ExcerptsAside title="话题" unit={`${allTags.length - 1} 个`}>
      {
        allTags.map((tag) => (
          <button
            class={`aside-item${tag === "全部" ? " is-active" : ""}`}
            type="button"
            data-tag={tag}
            aria-pressed={tag === "全部" ? "true" : "false"}
          >
            <span class="aside-item__label">{tag}</span>
            <span class="aside-item__count">
              {tag === "全部"
                ? conversations.length
                : conversations.filter((c) =>
                    (c.data.tags ?? []).includes(tag),
                  ).length}
            </span>
          </button>
        ))
      }
    </ExcerptsAside>

    <div class="excerpts-main">
      <!-- 对话卡片网格 -->
      <div class="conversations-grid" id="conversations-grid">
    {
      paginatedConversations.map((conversation) => (
        <div
          class="conversation-item"
          data-tags={(conversation.data.tags ?? []).join(",")}
        >
          <ConversationCard conversation={conversation} />
        </div>
      ))
    }
  </div>

  <!-- 加载更多按钮 -->
  <div
    class="load-more-container"
    style="display: none;"
    id="load-more-container"
  >
    <button class="load-more-btn" id="load-more"> 加载更多 </button>
  </div>

      <!-- 空状态 -->
      <div class="empty-state" id="empty-state" style="display: none;">
        <p>暂无对话，敬请期待。</p>
      </div>
    </div>
  </div>
</main>
</MainLayout>

<script
  is:inline
  define:vars={{ ITEMS_PER_PAGE, conversations: conversations.length, allTags }}
>
  const ITEMS_PER_PAGE_VALUE = ITEMS_PER_PAGE;

  const pills = Array.from(
    document.querySelectorAll(".aside-item[data-tag]"),
  );
  const items = Array.from(document.querySelectorAll(".conversation-item"));
  const loadMoreBtn = document.getElementById("load-more");
  const loadMoreContainer = document.getElementById("load-more-container");
  const emptyState = document.getElementById("empty-state");
  const grid = document.getElementById("conversations-grid");

  let activeTag = "全部";
  let displayedCount = ITEMS_PER_PAGE_VALUE;

  // 筛选切换过渡：模块脚本可能晚于本脚本加载，调用时才取
  const withFilterTransition = (fn) =>
    window.runFilterTransition ? window.runFilterTransition(fn) : fn();

  // 应用过滤
  const applyFilter = () => {
    items.forEach((item) => {
      const tags = (item.dataset.tags || "").split(",").filter(Boolean);
      const visible = activeTag === "全部" || tags.includes(activeTag);
      item.style.display = visible ? "" : "none";
    });

    displayedCount = ITEMS_PER_PAGE_VALUE;
    updatePagination();
  };

  // 更新分页显示
  const updatePagination = () => {
    const visibleItems = items.filter((item) => item.style.display !== "none");

    visibleItems.forEach((item, index) => {
      if (index < displayedCount) {
        item.style.display = "";
      } else {
        item.style.display = "none";
      }
    });

    // 显示/隐藏加载更多按钮
    if (visibleItems.length > displayedCount) {
      loadMoreContainer.style.display = "block";
    } else {
      loadMoreContainer.style.display = "none";
    }

    // 显示/隐藏空状态
    if (visibleItems.length === 0) {
      grid.style.display = "none";
      emptyState.style.display = "block";
    } else {
      grid.style.display = "grid";
      emptyState.style.display = "none";
    }
  };

  // 标签点击
  pills.forEach((pill) => {
    pill.addEventListener("click", () => {
      withFilterTransition(() => {
        pills.forEach((p) => {
          p.classList.remove("is-active");
          p.setAttribute("aria-pressed", "false");
        });
        pill.classList.add("is-active");
        pill.setAttribute("aria-pressed", "true");
        activeTag = pill.dataset.tag || "全部";
        applyFilter();
      });
    });
  });

  // 加载更多
  loadMoreBtn?.addEventListener("click", () => {
    displayedCount += ITEMS_PER_PAGE_VALUE;
    updatePagination();
    // 平滑滚动
    setTimeout(() => {
      const visibleItems = items.filter(
        (item) => item.style.display !== "none",
      );
      const nextItem = visibleItems[displayedCount - ITEMS_PER_PAGE_VALUE];
      if (nextItem) {
        nextItem.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    }, 50);
  });

  // 初始化
  const urlParams = new URLSearchParams(window.location.search);
  const initialTag = urlParams.get("tag");

  if (initialTag) {
    const targetPill = pills.find((pill) => pill.dataset.tag === initialTag);
    if (targetPill) {
      pills.forEach((p) => {
        p.classList.remove("is-active");
        p.setAttribute("aria-pressed", "false");
      });
      targetPill.classList.add("is-active");
      targetPill.setAttribute("aria-pressed", "true");
      activeTag = initialTag;
      applyFilter();
    } else {
      pills[0]?.classList.add("is-active");
      updatePagination();
    }
  } else {
    pills[0]?.classList.add("is-active");
    updatePagination();
  }
</script>
