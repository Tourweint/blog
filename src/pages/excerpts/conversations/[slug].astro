---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import ConversationLayout from "../../../layouts/conversationlayout.astro";

export const toConversationSlug = (id: string) =>
  id.replace(/\.(md|mdx)$/i, "");

export async function getStaticPaths() {
  const conversations = await getCollection("conversations");

  return conversations.map((conversation) => ({
    params: { slug: toConversationSlug(conversation.id) },
    props: { post: conversation },
  }));
}

interface Props {
  post: CollectionEntry<"conversations">;
}

const { post } = Astro.props;
---

<ConversationLayout post={post} />
