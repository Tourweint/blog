---
import "../../../styles/index.css";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import MainLayout from "../../../layouts/mainlayout.astro";
import { excerpts } from "../../../utils/excerptsPaths";

const posts = await getCollection("posts");
const tagCounter = new Map<string, number>();

posts.forEach((post: CollectionEntry<"posts">) => {
  const tags = post.data.tags?.length ? post.data.tags : ["未分类"];
  tags.forEach((tag) => tagCounter.set(tag, (tagCounter.get(tag) ?? 0) + 1));
});

const tags = Array.from(tagCounter.entries())
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => a.name.localeCompare(b.name, "zh-CN"));
---

<MainLayout
  title="按主题阅读 - 多鸣的博客"
  description="按主题筛选我的文章"
  wide={true}
>
  <div class="excerpts-posts category-index">
    <header class="excerpts-posts__header">
      <p class="excerpts-posts__eyebrow">摘录</p>
      <h1 class="excerpts-posts__title">按主题阅读</h1>
      <p class="excerpts-posts__sub">
        选一个主题直接跳转，或者回到摘录列表查看全部。
      </p>
      <div class="excerpts-posts__meta">
        <span class="meta-item">共 {tags.length} 个主题</span>
        <span class="meta-sep">·</span>
        <a class="meta-link" href={excerpts.postsIndex}>返回摘录列表</a>
      </div>
    </header>

    <main class="category-index__main" aria-label="主题列表">
      {
        tags.length > 0 ? (
          <div class="category-index__grid">
            {tags.map((tag) => (
              <a
                class="category-index__card"
                href={excerpts.category(tag.name)}
              >
                <span class="category-index__name">{tag.name}</span>
                <span class="category-index__count">{tag.count} 篇</span>
              </a>
            ))}
          </div>
        ) : (
          <div class="no-results">暂无可用主题。</div>
        )
      }
    </main>
  </div>
</MainLayout>
