---
import "../../../../styles/index.css";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths } from "astro";
import MainLayout from "../../../../layouts/mainlayout.astro";
import Pagination from "../../../../components/Pagination.astro";
import { excerpts } from "../../../../utils/excerptsPaths";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection("posts");
  posts.sort(
    (a: CollectionEntry<"posts">, b: CollectionEntry<"posts">) =>
      b.data.pubDate.getTime() - a.data.pubDate.getTime(),
  );

  // 获取所有分类
  const allTags = new Set<string>();
  posts.forEach((post) => {
    if (post.data.tags?.length) {
      post.data.tags.forEach((tag) => allTags.add(tag));
    } else {
      allTags.add("未分类");
    }
  });

  // 为每个分类生成分页
  return Array.from(allTags).flatMap((tag) => {
    const filteredPosts = posts.filter((post) => {
      if (tag === "未分类") {
        return !post.data.tags?.length;
      }
      return post.data.tags?.includes(tag);
    });

    return paginate(filteredPosts, {
      params: { category: tag },
      pageSize: 8,
    });
  });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const { category } = Astro.params;

const posts = await getCollection("posts");
const categories = [
  "全部",
  ...Array.from(
    new Set(
      posts.flatMap((p) => (p.data.tags?.length ? p.data.tags : ["未分类"])),
    ),
  ).sort((a, b) => a.localeCompare(b, "zh-CN")),
];

// 生成分类的分页 URL
const getCategoryPageUrl = (pageNum: number) =>
  excerpts.category(category!, pageNum);

const listBaseUrl = excerpts.category(category!, page.currentPage);
---

<MainLayout
  title={`${category} - Tourweint/多鸣`}
  description={`${category}分类下的文章`}
  wide={true}
>
  <div class="excerpts-posts">
    <header class="excerpts-posts__header">
      <p class="excerpts-posts__eyebrow">摘录</p>
      <h1 class="excerpts-posts__title">按主题阅读</h1>
      <p class="excerpts-posts__sub">当前主题：{category}</p>
      <div class="excerpts-posts__meta">
        <a class="meta-link" href={excerpts.postsIndex}>查看全部摘录</a>
        <span class="meta-sep">·</span>
        <a class="meta-link" href={excerpts.categoryIndex}>主题目录</a>
        <span class="meta-sep">·</span>
        <a class="meta-link" href={excerpts.rootHref}>回到摘录首页</a>
      </div>
    </header>

    <div class="excerpts-posts__layout">
      <aside class="excerpts-posts__aside" aria-label="主题目录">
        <div class="aside-card">
          <div class="aside-title">主题</div>
          <nav class="aside-list">
            {
              categories.map((cat) => {
                const count =
                  cat === "全部"
                    ? posts.length
                    : posts.filter((p) => p.data.tags?.includes(cat)).length;
                return (
                  <a
                    href={
                      cat === "全部"
                        ? excerpts.postsIndex
                        : excerpts.category(cat)
                    }
                    class={`aside-link${cat === category ? " is-active" : ""}`}
                  >
                    <span class="aside-link__label">{cat}</span>
                    <span class="aside-link__count">{count}</span>
                  </a>
                );
              })
            }
          </nav>
        </div>
      </aside>

      <main class="excerpts-posts__main">
        <h2 class="excerpts-posts__section-title" id="list-title">
          {category}
        </h2>
        {
          page.data.length > 0 ? (
            <div class="post-grid">
              {page.data.map((post: CollectionEntry<"posts">) => (
                <a
                  href={`${excerpts.postDetail(post.id)}?from=${encodeURIComponent(listBaseUrl)}`}
                  class="post-card-link"
                  data-title={post.data.title.toLowerCase()}
                  data-desc={(post.data.description || "").toLowerCase()}
                  data-tags={(post.data.tags || ["未分类"])
                    .join(",")
                    .toLowerCase()}
                >
                  <article class="post-card">
                    <div class="card-meta">
                      <span>
                        {post.data.pubDate.toLocaleDateString("zh-cn")}
                      </span>
                      <div class="card-tags">
                        {post.data.tags?.map((t: string) => (
                          <span class="card-tag">{t}</span>
                        ))}
                      </div>
                    </div>
                    <h3 class="post-title">{post.data.title}</h3>
                    {post.data.description && (
                      <p class="post-desc">{post.data.description}</p>
                    )}
                    <span class="read-more">阅读全文 →</span>
                  </article>
                </a>
              ))}
            </div>
          ) : (
            <div class="no-results">该分类下暂无文章。</div>
          )
        }

        <Pagination
          currentPage={page.currentPage}
          totalPages={page.lastPage}
          getPageUrl={getCategoryPageUrl}
        />
      </main>
    </div>
  </div>
</MainLayout>

<script is:inline define:vars={{ POST_DETAIL_PREFIX: excerpts.postDetail("") }}>
  const urlParams = new URLSearchParams(window.location.search);
  const scrollTarget = urlParams.get("scrollTo");

  if (scrollTarget) {
    const targetCard = document.querySelector(
      `a.post-card-link[href^="${POST_DETAIL_PREFIX}${scrollTarget}"]`,
    );

    if (targetCard) {
      setTimeout(() => {
        targetCard.scrollIntoView({ behavior: "smooth", block: "center" });
        targetCard.classList.add("highlight-card");
        setTimeout(() => targetCard.classList.remove("highlight-card"), 2000);
      }, 100);
    }

    const url = new URL(window.location.href);
    url.searchParams.delete("scrollTo");
    window.history.replaceState({}, "", url);
  }
</script>
