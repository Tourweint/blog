---
import MainLayout from "../../layouts/mainlayout.astro";
import ChannelHero from "../../components/ChannelHero.astro";
import "../../styles/excerpts.css";

import EntryExcerptsConversations from "../../components/entries/EntryExcerptsConversations.astro";
import EntryExcerptsNotes from "../../components/entries/EntryExcerptsNotes.astro";
import EntryExcerptsPersons from "../../components/entries/EntryExcerptsPersons.astro";
import EntryExcerptsPosts from "../../components/entries/EntryExcerptsPosts.astro";
---

<MainLayout
  title="摘录 - Tourweint/多鸣"
  description="进入摘录内容：文章、短句、人物、对话"
>
  <section class="excerpts-home">
    <ChannelHero eyebrow="Excerpts" title="摘录主页">
      <span slot="meta">
        <span class="meta-item">4 个栏目</span>
      </span>
    </ChannelHero>

    <div class="excerpts-home__grid" role="list">
      <div role="listitem"><EntryExcerptsPosts /></div>
      <div role="listitem"><EntryExcerptsNotes /></div>
      <div role="listitem"><EntryExcerptsPersons /></div>
      <div role="listitem"><EntryExcerptsConversations /></div>
    </div>
  </section>
</MainLayout>
