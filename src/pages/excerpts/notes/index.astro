---
import MainLayout from "../../../layouts/mainlayout.astro";
import { excerpts } from "../../../utils/excerptsPaths";
import { getNoteViews, toNoteMeta } from "../../../utils/notesData";
import type { NoteView } from "../../../utils/notesData";
import "../../../styles/notes.css";

// 首屏服务端渲染的卡片数；其余卡片由客户端根据 JSON island 构建。
// dev 模式会为每个服务端元素注入 source-loc 注解，一次性渲染上百张卡片会显著拖慢，
// 因此只 SSR 首屏，把元素数量降到与其它分页列表一致。
const INITIAL_RENDER = 18;

const notes: NoteView[] = await getNoteViews();
const tagFilters = ["全部", ...new Set(notes.flatMap((n) => n.tags))];

// 仅为首屏卡片生成 year/month 分组结构用于 SSR
type Group =
  | { type: "year"; value: string }
  | { type: "month"; value: string; rawValue: string; year: string }
  | { type: "note"; note: NoteView };

const buildGroups = (list: NoteView[]): Group[] => {
  const groups: Group[] = [];
  let currentYear = 0;
  let currentMonth = "";
  list.forEach((note) => {
    if (note.year !== currentYear) {
      currentYear = note.year;
      groups.push({ type: "year", value: currentYear.toString() });
      currentMonth = "";
    }
    if (note.month !== currentMonth) {
      currentMonth = note.month;
      groups.push({
        type: "month",
        value: `${currentMonth}月`,
        rawValue: currentMonth,
        year: currentYear.toString(),
      });
    }
    groups.push({ type: "note", note });
  });
  return groups;
};

const displayGroups = buildGroups(notes.slice(0, INITIAL_RENDER));

// 只下发元数据（不含正文）；正文由 /excerpts/notes/bodies.json 异步加载。
// 转义 "<" 防止闭合 <script>。
const notesMetaJson = JSON.stringify(notes.map(toNoteMeta)).replace(
  /</g,
  "\\u003c",
);
---

<MainLayout title="句子簿 - Tourweint/多鸣" description="轻量想法与摘抄">
  <section class="notes-hero">
    <div class="notes-hero__content">
      <p class="notes-hero__eyebrow">摘录</p>
      <h1 class="notes-hero__title">摘录 · 短句</h1>
      <p class="notes-hero__sub">
        把瞬间的灵感、摘录与想法归档成可检索的句子簿。
      </p>
      <div class="notes-hero__meta">
        <span class="meta-item">共 {notes.length} 条</span>
        <span class="meta-sep">·</span>
        <a class="meta-link" href={excerpts.notesMonthsIndex}> 按月份浏览 </a>
        <span class="meta-sep">·</span>
        <a class="meta-link" href={excerpts.rootHref}>回到摘录首页</a>
      </div>
    </div>
    <div class="notes-hero__actions">
      <button class="random-btn" id="random-note">
        <span>🎲</span>
        <span>随机一条</span>
      </button>
    </div>
  </section>

  <section class="notes-filters">
    <div class="filter-head">
      <span class="filter-title">标签</span>
      <button class="filter-toggle" id="toggle-tags" aria-expanded="false">
        展开全部
      </button>
    </div>
    <div class="filter-chips" data-collapsed="true">
      {
        tagFilters.map((t) => (
          <button class="chip" data-tag={t}>
            {t}
          </button>
        ))
      }
    </div>
  </section>

  <div class="notes-stream" id="note-list">
    {
      displayGroups.map((item) => {
        if (item.type === "year") {
          return (
            <h2 class="timeline-year" data-type="year-header">
              {item.value}
            </h2>
          );
        }
        if (item.type === "month") {
          return (
            <h3 class="timeline-month" data-type="month-header">
              <a
                href={excerpts.notesMonth(item.year, item.rawValue)}
                class="month-link"
              >
                {item.value}
                <span class="link-icon">↗</span>
              </a>
            </h3>
          );
        }

        const note = item.note;
        return (
          <article
            class="note-card"
            data-tags={note.tags.join(",")}
            data-year={note.year}
            data-month={note.month}
            data-note-key={note.key}
          >
            <div class="note-meta">
              <time datetime={note.dateISO}>{note.dateLabel}</time>
              <span>·</span>
              <span class="note-source">{note.source}</span>
            </div>
            <h2 class="note-title">{note.title}</h2>
            <p class="note-hook">{note.hook}</p>
            <div class="note-body content" hidden></div>
            <div class="note-footer">
              <div class="tag-row">
                {note.tags.map((tag: string) => (
                  <span class="tag-pill">{tag}</span>
                ))}
              </div>
              <button
                class="toggle-body"
                data-label-open="展开"
                data-label-close="收起"
                aria-expanded="false"
              >
                展开
              </button>
            </div>
          </article>
        );
      })
    }
  </div>

  <div class="load-more-container">
    <button class="load-more-btn" id="load-more">加载更多</button>
  </div>

  <script
    is:inline
    type="application/json"
    id="notes-data"
    set:html={notesMetaJson}
  />
</MainLayout>

<script>
  import {
    setCardOpen,
    bindNoteToggles,
    prefetchBodiesWhenIdle,
  } from "../../../scripts/noteBody";

  const INITIAL_RENDER = 18;

  type NoteMeta = {
    key: string;
    title: string;
    hook: string;
    tags: string[];
    year: number;
    month: string;
    dateISO: string;
    dateLabel: string;
    source: string;
  };

  // 读取服务端下发的笔记元数据（不含正文）
  const dataEl = document.getElementById("notes-data");
  const allNotes: NoteMeta[] = dataEl
    ? JSON.parse(dataEl.textContent || "[]")
    : [];

  const esc = (value: unknown) =>
    String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");

  const yearHtml = (year: number) =>
    `<h2 class="timeline-year" data-type="year-header">${year}</h2>`;

  const monthHtml = (n: NoteMeta) =>
    `<h3 class="timeline-month" data-type="month-header"><a href="/excerpts/notes/${n.year}/${n.month}" class="month-link">${n.month}月<span class="link-icon">↗</span></a></h3>`;

  const cardHtml = (n: NoteMeta) => `
    <article class="note-card" data-tags="${esc(n.tags.join(","))}" data-year="${n.year}" data-month="${n.month}" data-note-key="${n.key}">
      <div class="note-meta">
        <time datetime="${n.dateISO}">${n.dateLabel}</time>
        <span>·</span>
        <span class="note-source">${esc(n.source)}</span>
      </div>
      <h2 class="note-title">${esc(n.title)}</h2>
      <p class="note-hook">${esc(n.hook)}</p>
      <div class="note-body content" hidden></div>
      <div class="note-footer">
        <div class="tag-row">${n.tags
          .map((t) => `<span class="tag-pill">${esc(t)}</span>`)
          .join("")}</div>
        <button class="toggle-body" data-label-open="展开" data-label-close="收起" aria-expanded="false">展开</button>
      </div>
    </article>`;

  // 构建首屏之外的其余卡片（客户端构建无 dev source-loc 开销，速度很快）
  const stream = document.getElementById("note-list");
  if (stream && allNotes.length > INITIAL_RENDER) {
    let tail = "";
    const seed = allNotes[INITIAL_RENDER - 1];
    let currentYear: number | null = seed ? seed.year : null;
    let currentMonth: string | null = seed ? seed.month : null;
    for (let i = INITIAL_RENDER; i < allNotes.length; i++) {
      const n = allNotes[i];
      if (n.year !== currentYear) {
        tail += yearHtml(n.year);
        currentYear = n.year;
        currentMonth = null;
      }
      if (n.month !== currentMonth) {
        tail += monthHtml(n);
        currentMonth = n.month;
      }
      tail += cardHtml(n);
    }
    stream.insertAdjacentHTML("beforeend", tail);
  }

  const ITEMS_PER_PAGE = 18;

  const tagButtons = Array.from(document.querySelectorAll(".chip[data-tag]"));
  const cards = Array.from(document.querySelectorAll(".note-card"));
  const headers = Array.from(
    document.querySelectorAll("[data-type$='-header']"),
  );
  const randomBtn = document.getElementById("random-note");
  const loadMoreBtn = document.getElementById("load-more");
  const toggleTagsBtn = document.getElementById("toggle-tags");

  let activeTag = "全部";
  let displayedCount = ITEMS_PER_PAGE;
  let tagsCollapsed = true;
  const MAX_VISIBLE_TAGS = 12;

  const expandCard = (card: HTMLElement) => setCardOpen(card, true);

  const applyFilter = () => {
    const isAll = activeTag === "全部";

    let visibleCount = 0;
    cards.forEach((card) => {
      const tags = (card.getAttribute("data-tags") || "").split(",");
      const matched = isAll || tags.includes(activeTag);
      if (!matched) {
        (card as HTMLElement).style.display = "none";
        return;
      }

      visibleCount += 1;
      (card as HTMLElement).style.display =
        visibleCount <= displayedCount ? "" : "none";
    });

    headers.forEach((header) => {
      const next = header.nextElementSibling;
      let hasVisible = false;
      let cursor = next;
      while (cursor && !cursor.matches("[data-type$='-header']")) {
        if (
          cursor.matches(".note-card") &&
          (cursor as HTMLElement).style.display !== "none"
        ) {
          hasVisible = true;
          break;
        }
        cursor = cursor.nextElementSibling;
      }
      (header as HTMLElement).style.display = hasVisible ? "" : "none";
    });

    if (loadMoreBtn) {
      loadMoreBtn.toggleAttribute("hidden", visibleCount <= displayedCount);
    }
  };

  const updateTagToggle = () => {
    if (!toggleTagsBtn) return;
    if (tagButtons.length <= MAX_VISIBLE_TAGS) {
      toggleTagsBtn.setAttribute("hidden", "true");
      tagButtons.forEach((btn) => btn.removeAttribute("hidden"));
      return;
    }

    toggleTagsBtn.removeAttribute("hidden");
    toggleTagsBtn.textContent = tagsCollapsed
      ? `展开全部 (${tagButtons.length})`
      : "收起标签";
    toggleTagsBtn.setAttribute("aria-expanded", String(!tagsCollapsed));

    tagButtons.forEach((btn, index) => {
      const isActive = btn.classList.contains("active");
      const shouldHide =
        tagsCollapsed && index >= MAX_VISIBLE_TAGS && !isActive;
      if (shouldHide) {
        btn.setAttribute("hidden", "true");
      } else {
        btn.removeAttribute("hidden");
      }
    });
  };

  tagButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      tagButtons.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      activeTag = btn.getAttribute("data-tag") || "全部";
      displayedCount = ITEMS_PER_PAGE;
      updateTagToggle();
      applyFilter();
    });
  });

  loadMoreBtn?.addEventListener("click", () => {
    displayedCount += ITEMS_PER_PAGE;
    applyFilter();
  });

  // 为全部卡片（含客户端补建的）绑定展开/收起
  bindNoteToggles();

  randomBtn?.addEventListener("click", () => {
    if (!cards.length) return;

    const visibleCards = cards.filter(
      (card) => (card as HTMLElement).style.display !== "none",
    );
    const pool = visibleCards.length ? visibleCards : cards;
    if (!pool.length) return;

    const pick = pool[Math.floor(Math.random() * pool.length)] as HTMLElement;
    expandCard(pick as HTMLElement);
    pick.scrollIntoView({
      behavior: "smooth",
      block: "center",
    });
    pick.classList.add("flash");
    setTimeout(() => pick.classList.remove("flash"), 1200);
  });

  // Init default active state
  const defaultBtn = tagButtons.find(
    (b) => b.getAttribute("data-tag") === "全部",
  );
  defaultBtn?.classList.add("active");
  updateTagToggle();
  applyFilter();

  toggleTagsBtn?.addEventListener("click", () => {
    tagsCollapsed = !tagsCollapsed;
    updateTagToggle();
  });

  // 浏览器空闲时预取正文，让首次展开更顺滑
  prefetchBodiesWhenIdle();
</script>
