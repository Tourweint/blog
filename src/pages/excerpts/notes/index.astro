---
import { getCollection, render } from "astro:content";

import MainLayout from "../../../layouts/mainlayout.astro";
import { excerpts } from "../../../utils/excerptsPaths";
import "../../../styles/notes.css";

const resolveDate = (data: any) => data.pubDate || data.date || new Date();

const flatten = (text: string) =>
  text
    .replace(/\[(.*?)\]\((.*?)\)/g, "$1")
    .replace(/[#!>*`~_|>-]/g, " ")
    .replace(/\s+/g, " ")
    .trim();

const createExcerpt = (note: any, max = 140) => {
  const source = note.data.description || note.data.text || note.body || "";
  const clean = flatten(source);
  if (!clean) return "随手的一句短摘";
  return clean.length > max ? `${clean.slice(0, max)}…` : clean;
};

const rawNotes = (await getCollection("notes")).sort(
  (a, b) => resolveDate(b.data).getTime() - resolveDate(a.data).getTime(),
);

// Group notes by Year and Month for archive links
const timelineGroups = rawNotes.reduce(
  (acc: any, note) => {
    const date = resolveDate(note.data);
    const year = date.getFullYear();
    const month = (date.getMonth() + 1).toString().padStart(2, "0");
    const yKey = year.toString();
    if (!acc[yKey]) acc[yKey] = {};
    if (!acc[yKey][month]) acc[yKey][month] = [];
    acc[yKey][month].push(note);
    return acc;
  },
  {} as Record<string, Record<string, any[]>>,
);

const sortedYears = Object.keys(timelineGroups).sort(
  (a, b) => parseInt(b) - parseInt(a),
);

const notes = await Promise.all(
  rawNotes.map(async (note) => {
    const { Content } = await render(note);
    const resolvedDate = resolveDate(note.data);
    const tags: string[] = note.data.tags?.length ? note.data.tags : ["未分类"];
    const hook = createExcerpt(note);
    const title = note.data.title || hook || "未命名短句";
    return {
      ...note,
      Content,
      hook,
      title,
      tags,
      year: resolvedDate.getFullYear(),
      month: (resolvedDate.getMonth() + 1).toString().padStart(2, "0"),
      date: resolvedDate,
      source: note.data.source || "原创",
    };
  }),
);

const tagFilters = ["全部", ...new Set(notes.flatMap((n) => n.tags))];

// Generate grouped structure for rendering
const displayGroups: {
  type: "year" | "month" | "note";
  value?: string;
  rawValue?: string;
  year?: string;
  note?: any;
}[] = [];
let currentYear = 0;
let currentMonth = "";

notes.forEach((note) => {
  if (note.year !== currentYear) {
    currentYear = note.year;
    displayGroups.push({ type: "year", value: currentYear.toString() });
    currentMonth = "";
  }
  if (note.month !== currentMonth) {
    currentMonth = note.month;
    displayGroups.push({
      type: "month",
      value: `${currentMonth}月`,
      rawValue: currentMonth,
      year: currentYear.toString(),
    });
  }
  displayGroups.push({ type: "note", note });
});

const ITEMS_PER_PAGE = 18;
---

<MainLayout title="句子簿 - Tourweint/多鸣" description="轻量想法与摘抄">
  <section class="hero">
    <div>
      <p class="eyebrow">Notes</p>
      <h1>留住短句的力度</h1>
    </div>
    <button class="random-btn" id="random-note">
      <span>🎲</span>
      <span>随机一条</span>
    </button>
  </section>

  <div class="filter-bar">
    <div class="filter-group">
      <span class="filter-label">标签</span>
      <div class="filter-chips">
        {
          tagFilters.map((t) => (
            <button class="chip" data-tag={t}>
              {t}
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <div class="notes-stream" id="note-list">
    {
      displayGroups.map((item) => {
        if (item.type === "year") {
          return (
            <h2 class="timeline-year" data-type="year-header">
              {item.value}
            </h2>
          );
        }
        if (item.type === "month") {
          return (
            <h3 class="timeline-month" data-type="month-header">
              <a
                href={excerpts.notesMonth(item.year!, item.rawValue!)}
                class="month-link"
              >
                {item.value}
                <span class="link-icon">↗</span>
              </a>
            </h3>
          );
        }

        const note = item.note;
        const NoteContent = note.Content;
        return (
          <article
            class="note-card"
            data-tags={note.tags.join(",")}
            data-year={note.year}
            data-month={note.month}
          >
            <div class="note-meta">
              <time datetime={note.date.toISOString().split("T")[0]}>
                {note.date.toLocaleDateString("zh-cn")}
              </time>
              <span>·</span>
              <span class="note-source">{note.source}</span>
            </div>
            <h2 class="note-title">{note.title}</h2>
            <p class="note-hook">{note.hook}</p>
            <div class="note-body content" hidden>
              <NoteContent />
            </div>
            <div class="note-footer">
              <div class="tag-row">
                {note.tags.map((tag: string) => (
                  <span class="tag-pill">{tag}</span>
                ))}
              </div>
              <button
                class="toggle-body"
                data-label-open="展开"
                data-label-close="收起"
                aria-expanded="false"
              >
                展开
              </button>
            </div>
          </article>
        );
      })
    }
  </div>

  <div class="load-more-container">
    <button class="load-more-btn" id="load-more">加载更多</button>
  </div>
</MainLayout>

<script>
  const ITEMS_PER_PAGE = 18;

  const tagButtons = Array.from(document.querySelectorAll(".chip[data-tag]"));
  const cards = Array.from(document.querySelectorAll(".note-card"));
  const headers = Array.from(
    document.querySelectorAll("[data-type$='-header']"),
  );
  const randomBtn = document.getElementById("random-note");
  const loadMoreBtn = document.getElementById("load-more");

  let activeTag = "全部";
  let displayedCount = ITEMS_PER_PAGE;

  const expandCard = (card: HTMLElement) => {
    card.setAttribute("data-state", "open");
    card.classList.add("expanded");
    card.querySelector(".note-body")?.removeAttribute("hidden");
    const toggle = card.querySelector(".toggle-body");
    if (toggle) {
      const toggleElement = toggle as HTMLElement;
      toggleElement.textContent = toggleElement.dataset.labelClose || "收起";
      toggleElement.setAttribute("aria-expanded", "true");
    }
  };

  const collapseCard = (card: HTMLElement) => {
    card.setAttribute("data-state", "closed");
    card.classList.remove("expanded");
    card.querySelector(".note-body")?.setAttribute("hidden", "true");
    const toggle = card.querySelector(".toggle-body");
    if (toggle) {
      const toggleElement = toggle as HTMLElement;
      toggleElement.textContent = toggleElement.dataset.labelOpen || "展开";
      toggleElement.setAttribute("aria-expanded", "false");
    }
  };

  const applyFilter = () => {
    const isAll = activeTag === "全部";

    let visibleCount = 0;
    cards.forEach((card) => {
      const tags = (card.getAttribute("data-tags") || "").split(",");
      const matched = isAll || tags.includes(activeTag);
      if (!matched) {
        (card as HTMLElement).style.display = "none";
        return;
      }

      visibleCount += 1;
      (card as HTMLElement).style.display =
        visibleCount <= displayedCount ? "" : "none";
    });

    headers.forEach((header) => {
      const next = header.nextElementSibling;
      let hasVisible = false;
      let cursor = next;
      while (cursor && !cursor.matches("[data-type$='-header']")) {
        if (
          cursor.matches(".note-card") &&
          (cursor as HTMLElement).style.display !== "none"
        ) {
          hasVisible = true;
          break;
        }
        cursor = cursor.nextElementSibling;
      }
      (header as HTMLElement).style.display = hasVisible ? "" : "none";
    });

    if (loadMoreBtn) {
      loadMoreBtn.toggleAttribute("hidden", visibleCount <= displayedCount);
    }
  };

  tagButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      tagButtons.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      activeTag = btn.getAttribute("data-tag") || "全部";
      displayedCount = ITEMS_PER_PAGE;
      applyFilter();
    });
  });

  loadMoreBtn?.addEventListener("click", () => {
    displayedCount += ITEMS_PER_PAGE;
    applyFilter();
  });

  const toggleButtons = Array.from(document.querySelectorAll(".toggle-body"));
  toggleButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const card = btn.closest(".note-card");
      if (!card) return;
      const isOpen = card.getAttribute("data-state") === "open";
      isOpen
        ? collapseCard(card as HTMLElement)
        : expandCard(card as HTMLElement);
    });
  });

  randomBtn?.addEventListener("click", () => {
    if (!cards.length) return;
    const pick = cards[Math.floor(Math.random() * cards.length)];
    expandCard(pick as HTMLElement);
    (pick as HTMLElement).scrollIntoView({
      behavior: "smooth",
      block: "center",
    });
    pick.classList.add("flash");
    setTimeout(() => pick.classList.remove("flash"), 1200);
  });

  // Init default active state
  const defaultBtn = tagButtons.find(
    (b) => b.getAttribute("data-tag") === "全部",
  );
  defaultBtn?.classList.add("active");
  applyFilter();
</script>
