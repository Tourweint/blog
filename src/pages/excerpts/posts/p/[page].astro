---
import "../../../../styles/index.css";
import "../../../../styles/excerpts-aside.css";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import MainLayout from "../../../../layouts/mainlayout.astro";
import ChannelHero from "../../../../components/ChannelHero.astro";
import ExcerptsTabs from "../../../../components/excerpts/ExcerptsTabs.astro";
import ExcerptsAside from "../../../../components/excerpts/ExcerptsAside.astro";
import Pagination from "../../../../components/Pagination.astro";
import { excerpts } from "../../../../utils/excerptsPaths";

export const PAGE_SIZE = 8;

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  posts.sort(
    (a: CollectionEntry<"posts">, b: CollectionEntry<"posts">) =>
      b.data.pubDate.getTime() - a.data.pubDate.getTime(),
  );

  const totalPages = Math.ceil(posts.length / PAGE_SIZE);
  if (totalPages <= 1) return [];

  return Array.from({ length: totalPages - 1 }, (_, index) => {
    const page = index + 2;
    return {
      params: { page: page.toString() },
    };
  });
}

const posts = await getCollection("posts");
posts.sort(
  (a: CollectionEntry<"posts">, b: CollectionEntry<"posts">) =>
    b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const categories = [
  "全部",
  ...Array.from(
    new Set(
      posts.flatMap((p) => (p.data.tags?.length ? p.data.tags : ["未分类"])),
    ),
  ).sort((a, b) => a.localeCompare(b, "zh-CN")),
];

const categoryItems = categories.map((cat) => ({
  label: cat,
  href: cat === "全部" ? excerpts.postsIndex : excerpts.category(cat),
  count:
    cat === "全部"
      ? posts.length
      : posts.filter((p) => p.data.tags?.includes(cat)).length,
  active: cat === "全部",
}));

const currentPage = Number(Astro.params.page);
const totalPages = Math.ceil(posts.length / PAGE_SIZE);
const startIndex = (currentPage - 1) * PAGE_SIZE;
const paginatedPosts = posts.slice(startIndex, startIndex + PAGE_SIZE);

const getPageUrl = (page: number) => excerpts.postsPage(page);
---

<MainLayout
  title={`摘录 - 第 ${currentPage} 页 - Tourweint/多鸣`}
  description={`摘录文章列表，第 ${currentPage} 页`}
  wide={true}
>
  <div class="excerpts-posts">
    <ChannelHero title="文章">
      <span slot="meta">
        <span class="meta-item">共 {posts.length} 篇</span>
        <span class="meta-sep">·</span>
        <span class="meta-item">第 {currentPage} 页</span>
      </span>
    </ChannelHero>

    <ExcerptsTabs active="posts" />

    <div class="excerpts-layout">
      <ExcerptsAside title="主题" unit={`${categories.length - 1} 个`}>
        {
          categoryItems.map((item) => (
            <a
              class={`aside-item${item.active ? " is-active" : ""}`}
              href={item.href}
              aria-current={item.active ? "page" : undefined}
            >
              <span class="aside-item__label">{item.label}</span>
              <span class="aside-item__count">{item.count}</span>
            </a>
          ))
        }
      </ExcerptsAside>

      <div class="excerpts-main">
        <h2 class="excerpts-posts__section-title" id="list-title">
          最新摘录（第 {currentPage} 页）
        </h2>
        {
          paginatedPosts.length > 0 ? (
            <div class="post-grid">
              {paginatedPosts.map((post: CollectionEntry<"posts">) => (
                <a
                  href={excerpts.postDetail(post.id)}
                  class="post-card-link"
                  data-title={post.data.title.toLowerCase()}
                  data-desc={(post.data.description || "").toLowerCase()}
                  data-tags={(post.data.tags || ["未分类"])
                    .join(",")
                    .toLowerCase()}
                >
                  <article class="post-card">
                    <div class="card-meta">
                      <span>
                        {post.data.pubDate.toLocaleDateString("zh-cn")}
                      </span>
                      <div class="card-tags">
                        {post.data.tags?.map((t: string) => (
                          <span class="card-tag">{t}</span>
                        ))}
                      </div>
                    </div>
                    <h3 class="post-title">{post.data.title}</h3>
                    {post.data.description && (
                      <p class="post-desc">{post.data.description}</p>
                    )}
                    <span class="read-more">阅读全文 →</span>
                  </article>
                </a>
              ))}
            </div>
          ) : (
            <div class="no-results">该页暂无文章。</div>
          )
        }

        <Pagination
          currentPage={currentPage}
          totalPages={totalPages}
          getPageUrl={getPageUrl}
        />
      </div>
    </div>
  </div>
</MainLayout>

<script is:inline define:vars={{ POST_DETAIL_PREFIX: excerpts.postDetail("") }}>
  const urlParams = new URLSearchParams(window.location.search);
  const scrollTarget = urlParams.get("scrollTo");

  if (scrollTarget) {
    const targetCard = document.querySelector(
      `a.post-card-link[href^="${POST_DETAIL_PREFIX}${scrollTarget}"]`,
    );

    if (targetCard) {
      setTimeout(() => {
        targetCard.scrollIntoView({ behavior: "smooth", block: "center" });
        targetCard.classList.add("highlight-card");
        setTimeout(() => targetCard.classList.remove("highlight-card"), 2000);
      }, 100);
    }

    const url = new URL(window.location.href);
    url.searchParams.delete("scrollTo");
    window.history.replaceState({}, "", url);
  }
</script>
