---
import { getCollection } from "astro:content";
import MainLayout from "../../../../../layouts/mainlayout.astro";
import OriginalsFilter from "../../../../../components/originals/OriginalsFilter.astro";
import ProjectCard from "../../../../../components/originals/ProjectCard.astro";
import Pagination from "../../../../../components/Pagination.astro";
import "../../../../../styles/originals/originals.css";
import "../../../../../styles/originals/projects.css";

export const PAGE_SIZE = 12;

const isStatusTag = (tag: string) => {
  const lowered = tag.toLowerCase();
  return lowered === "wip" || lowered === "todo" || lowered === "done";
};

export async function getStaticPaths() {
  const allOriginals = await getCollection("originals");
  const projectsPosts = allOriginals
    .filter((post) => post.data.category === "projects")
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

  const totalPages = Math.ceil(projectsPosts.length / PAGE_SIZE);
  if (totalPages <= 1) return [];

  return Array.from({ length: totalPages - 1 }, (_, index) => {
    const page = index + 2;
    return {
      params: { page: page.toString() },
    };
  });
}

const allOriginals = await getCollection("originals");
const projectsPosts = allOriginals
  .filter((post) => post.data.category === "projects")
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const listIndexHref = "/originals/projects/projects";
const listBaseHref = Astro.url.pathname;

const currentPage = Number(Astro.params.page);
const totalPages = Math.ceil(projectsPosts.length / PAGE_SIZE);
const startIndex = (currentPage - 1) * PAGE_SIZE;
const paginatedPosts = projectsPosts.slice(startIndex, startIndex + PAGE_SIZE);

const getPageUrl = (page: number) =>
  page === 1 ? listIndexHref : `${listIndexHref}/p/${page}`;

const systemsCount = allOriginals.filter(
  (post) => post.data.category === "systems",
).length;
const fragmentsCount = allOriginals.filter(
  (post) => post.data.category === "fragments",
).length;

const counts = {
  systems: systemsCount,
  fragments: fragmentsCount,
  projects: projectsPosts.length,
};

const tagCountsMap = new Map<string, number>();
for (const post of projectsPosts) {
  const filtered = (post.data.tags ?? []).filter((t) => !isStatusTag(t));
  const uniqueTags = new Set(filtered);
  for (const tag of uniqueTags) {
    tagCountsMap.set(tag, (tagCountsMap.get(tag) ?? 0) + 1);
  }
}

const tagCounts = Array.from(tagCountsMap.entries())
  .map(([tag, count]) => ({ tag, count }))
  .sort((a, b) => a.tag.localeCompare(b.tag, "zh-CN"));
---

<MainLayout
  title={`项目 / 实验 - 原创（第 ${currentPage} 页）`}
  description={`我做过的项目、实验与背后的动机（第 ${currentPage} 页）`}
  wide={true}
>
  <div class="projects-page">
    <header class="projects-header">
      <p class="eyebrow">原触发</p>
      <h1 class="projects-title">
        <span class="title-icon" aria-hidden="true">🚀</span>
        项目 / 实验
      </h1>
      <p class="projects-intro">
        用实践验证想法，用结果反思路径。<br />
        从动机、过程到复盘、教训，完整记录每个尝试。
      </p>

      <OriginalsFilter active="projects" counts={counts} />
    </header>

    <div class="originals-layout">
      {
        tagCounts.length > 0 && (
          <aside class="originals-aside" aria-label="标签">
            <div class="originals-aside-card">
              <div class="originals-aside-title">标签</div>
              <nav class="originals-aside-list">
                <a
                  class="tagpill is-active"
                  href={listBaseHref}
                  data-originals-tag=""
                >
                  <span class="tagpill-label">全部</span>
                  <span class="tagpill-count">{counts.projects}</span>
                </a>
                {tagCounts.map((t) => (
                  <a
                    class="tagpill"
                    href={`${listBaseHref}?tag=${encodeURIComponent(t.tag)}`}
                    data-originals-tag={t.tag}
                  >
                    <span class="tagpill-label">{t.tag}</span>
                    <span class="tagpill-count">{t.count}</span>
                  </a>
                ))}
              </nav>
            </div>
          </aside>
        )
      }

      <main class="originals-main">
        <section class="projects-list">
          {
            paginatedPosts.map((post) => (
              <ProjectCard post={post} listHref={listBaseHref} />
            ))
          }
        </section>

        <section class="projects-placeholder" data-originals-empty hidden>
          <div class="placeholder-icon">🏷️</div>
          <h2 class="placeholder-title">没有匹配的项目</h2>
          <p class="placeholder-text">试试切换其他标签，或选择「全部」。</p>
        </section>

        <Pagination
          currentPage={currentPage}
          totalPages={totalPages}
          getPageUrl={getPageUrl}
        />

        <aside class="projects-info">
          <h3 class="info-title">📋 项目会包含什么？</h3>
          <ul class="info-list">
            <li>为什么做这个项目（动机与背景）</li>
            <li>如何实现的（技术选型与过程）</li>
            <li>遇到了什么问题（挑战与解决）</li>
            <li>最终的结果与反思（收获与教训）</li>
          </ul>
        </aside>
      </main>
    </div>
  </div>
</MainLayout>
