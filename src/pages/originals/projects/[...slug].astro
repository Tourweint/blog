---
import { getCollection } from "astro:content";
import ContentDetailLayout from "../../../layouts/contentdetaillayout.astro";
import "../../../styles/posts.css";
import { excerpts } from "../../../utils/excerptsPaths";

export async function getStaticPaths() {
  const originals = await getCollection("originals");
  const projectsPosts = originals
    .filter((post) => post.slug.startsWith("projects/"))
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

  return projectsPosts.map((post, index) => ({
    params: { slug: post.slug.replace("projects/", "") },
    props: {
      post,
      prevItem:
        index > 0
          ? {
              href: `/originals/${projectsPosts[index - 1].slug}`,
              title: projectsPosts[index - 1].data.title,
            }
          : null,
      nextItem:
        index < projectsPosts.length - 1
          ? {
              href: `/originals/${projectsPosts[index + 1].slug}`,
              title: projectsPosts[index + 1].data.title,
            }
          : null,
    },
  }));
}

const { post, prevItem, nextItem } = Astro.props;
const { Content, headings } = await post.render();

const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);

const backUrl = "/originals/projects/projects";

const githubUrl = post.data.githubUrl;
const demoUrl = post.data.demoUrl;

// 计算阅读时间（若 frontmatter 未提供）
const content = post.body ?? "";
const chineseChars = (content.match(/[\u4e00-\u9fa5]/g) || []).length;
const englishWords = (content.match(/[a-zA-Z]+/g) || []).length;
const wordsPerMinute = 350;
const totalWords = chineseChars + englishWords;
const computedReadingTime = Math.max(1, Math.ceil(totalWords / wordsPerMinute));
const readingTime = post.data.readingTime ?? computedReadingTime;
---

<ContentDetailLayout
  seoTitle={`${post.data.title} - Tourweint/多鸣`}
  contentTitle={post.data.title}
  eyebrowText="原触发 · 原型"
  description={post.data.description || post.data.title}
  type="article"
  publishedTime={post.data.pubDate}
  tags={post.data.tags}
  image={post.data.image}
  headings={tocHeadings}
  backUrl={backUrl}
  backLabel="返回项目 / 实验"
  dateText={post.data.pubDate.toLocaleDateString("zh-cn")}
  readingTime={readingTime}
  totalWords={totalWords}
  tagsBaseHref={excerpts.categoryBaseHref}
  prevItem={prevItem}
  nextItem={nextItem}
>
  {
    (githubUrl || demoUrl) && (
      <div class="project-meta-links" slot="meta-extra" aria-label="项目链接">
        {githubUrl && (
          <a
            class="project-meta-link"
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub
          </a>
        )}
        {demoUrl && (
          <a
            class="project-meta-link"
            href={demoUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Demo
          </a>
        )}
      </div>
    )
  }
  <Content />
</ContentDetailLayout>
