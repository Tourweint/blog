---
import { getCollection } from "astro:content";
import MainLayout from "../../../../../layouts/mainlayout.astro";
import ChannelHero from "../../../../../components/ChannelHero.astro";
import OriginalsTabs from "../../../../../components/originals/OriginalsTabs.astro";
import FragmentCard from "../../../../../components/originals/FragmentCard.astro";
import OriginalsTagFilter from "../../../../../components/originals/OriginalsTagFilter.astro";
import Pagination from "../../../../../components/Pagination.astro";
import "../../../../../styles/originals/originals.css";
import "../../../../../styles/originals/fragments.css";

export const PAGE_SIZE = 12;

export async function getStaticPaths() {
  const allOriginals = await getCollection("originals");
  const fragmentsPosts = allOriginals
    .filter((post) => post.data.category === "fragments")
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

  const totalPages = Math.ceil(fragmentsPosts.length / PAGE_SIZE);
  if (totalPages <= 1) return [];

  return Array.from({ length: totalPages - 1 }, (_, index) => {
    const page = index + 2;
    return {
      params: { page: page.toString() },
    };
  });
}

const allOriginals = await getCollection("originals");
const fragmentsPosts = allOriginals
  .filter((post) => post.data.category === "fragments")
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const listIndexHref = "/originals/fragments/fragments";
const listBaseHref = Astro.url.pathname;

const currentPage = Number(Astro.params.page);
const totalPages = Math.ceil(fragmentsPosts.length / PAGE_SIZE);
const startIndex = (currentPage - 1) * PAGE_SIZE;
const paginatedPosts = fragmentsPosts.slice(startIndex, startIndex + PAGE_SIZE);

const getPageUrl = (page: number) =>
  page === 1 ? listIndexHref : `${listIndexHref}/p/${page}`;

const systemsCount = allOriginals.filter(
  (post) => post.data.category === "systems",
).length;
const projectsCount = allOriginals.filter(
  (post) => post.data.category === "projects",
).length;

const counts = {
  systems: systemsCount,
  fragments: fragmentsPosts.length,
  projects: projectsCount,
};

const tagCountsMap = new Map<string, number>();
for (const post of fragmentsPosts) {
  const uniqueTags = new Set(post.data.tags ?? []);
  for (const tag of uniqueTags) {
    tagCountsMap.set(tag, (tagCountsMap.get(tag) ?? 0) + 1);
  }
}

const tagCounts = Array.from(tagCountsMap.entries())
  .map(([tag, count]) => ({ tag, count }))
  .sort((a, b) => a.tag.localeCompare(b.tag, "zh-CN"));
---

<MainLayout
  title={`片段 - 原创（第 ${currentPage} 页）`}
  description={`灵感、未完成想法与判断的集合（第 ${currentPage} 页）`}
  wide={true}
>
  <div class="fragments-page">
    <ChannelHero title="片段">
      <span slot="meta">
        <span class="meta-item">共 {counts.fragments} 篇</span>
      </span>
    </ChannelHero>

    <OriginalsTabs active="fragments" counts={counts} />
    <OriginalsTagFilter />

    <div class="originals-layout">
      {
        tagCounts.length > 0 && (
          <aside class="originals-aside" aria-label="标签">
            <div class="originals-aside-card">
              <div class="originals-aside-title">标签</div>
              <nav class="originals-aside-list">
                <a
                  class="tagpill is-active"
                  href={listBaseHref}
                  data-originals-tag=""
                >
                  <span class="tagpill-label">全部</span>
                  <span class="tagpill-count">{counts.fragments}</span>
                </a>
                {tagCounts.map((t) => (
                  <a
                    class="tagpill"
                    href={`${listBaseHref}?tag=${encodeURIComponent(t.tag)}`}
                    data-originals-tag={t.tag}
                  >
                    <span class="tagpill-label">{t.tag}</span>
                    <span class="tagpill-count">{t.count}</span>
                  </a>
                ))}
              </nav>
            </div>
          </aside>
        )
      }

      <main class="originals-main">
        <section class="fragments-list">
          {
            paginatedPosts.map((post) => (
              <FragmentCard post={post} listHref={listBaseHref} />
            ))
          }
        </section>

        <section class="fragments-placeholder" data-originals-empty hidden>
          <h2 class="placeholder-title">没有匹配的片段</h2>
          <p class="placeholder-text">试试切换其他标签，或选择「全部」。</p>
        </section>

        <Pagination
          currentPage={currentPage}
          totalPages={totalPages}
          getPageUrl={getPageUrl}
        />
      </main>
    </div>
  </div>
</MainLayout>
