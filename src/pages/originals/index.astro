---
import "../../styles/originals/index.css";
import MainLayout from "../../layouts/mainlayout.astro";
---

<MainLayout
  title="原创 - Tourweint/多鸣"
  description="思想地图：我的思考、片段与实验"
  wide={true}
>
  <div class="originals-page">
    {/* 顶部标题区 */}
    <header class="originals-header">
      <h1 class="page-title">原创</h1>
      <p class="page-subtitle">独立的思考，未完成的想法</p>
    </header>

    {/* 内容卡片网格 */}
    <div class="content-grid">
      {/* 思考卡片 */}
      <a href="/originals/systems" class="content-card card-systems">
        <div class="card-icon">💭</div>
        <h2 class="card-title">思考</h2>
        <p class="card-description">成体系的观点与分析</p>
        <div class="card-status">筹备中</div>
        <div class="card-overlay"></div>
      </a>

      {/* 片段卡片 */}
      <a href="/originals/fragments" class="content-card card-fragments">
        <div class="card-icon">✨</div>
        <h2 class="card-title">片段</h2>
        <p class="card-description">灵感闪现，随性记录</p>
        <div class="card-status">筹备中</div>
        <div class="card-overlay"></div>
      </a>

      {/* 项目卡片 */}
      <a href="/originals/projects" class="content-card card-projects">
        <div class="card-icon">🚀</div>
        <h2 class="card-title">项目</h2>
        <p class="card-description">实验与尝试的记录</p>
        <div class="card-status">筹备中</div>
        <div class="card-overlay"></div>
      </a>
    </div>

    {/* 底部说明 */}
    <footer class="originals-footer">
      <p class="footer-note">这是认知的沉淀，不是时间的流水</p>
    </footer>
  </div>
</MainLayout>
