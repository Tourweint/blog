---
import { getCollection } from "astro:content";
import MainLayout from "../../../../../layouts/mainlayout.astro";
import OriginalsFilter from "../../../../../components/originals/OriginalsFilter.astro";
import SystemsCard from "../../../../../components/originals/SystemsCard.astro";
import Pagination from "../../../../../components/Pagination.astro";
import "../../../../../styles/originals/originals.css";
import "../../../../../styles/originals/systems.css";

export const PAGE_SIZE = 12;

export async function getStaticPaths() {
  const allOriginals = await getCollection("originals");
  const systemsPosts = allOriginals
    .filter((post) => post.data.category === "systems")
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

  const totalPages = Math.ceil(systemsPosts.length / PAGE_SIZE);
  if (totalPages <= 1) return [];

  return Array.from({ length: totalPages - 1 }, (_, index) => {
    const page = index + 2;
    return {
      params: { page: page.toString() },
    };
  });
}

const allOriginals = await getCollection("originals");
const systemsPosts = allOriginals
  .filter((post) => post.data.category === "systems")
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const listIndexHref = "/originals/systems/systems";
const listBaseHref = Astro.url.pathname;

const currentPage = Number(Astro.params.page);
const totalPages = Math.ceil(systemsPosts.length / PAGE_SIZE);
const startIndex = (currentPage - 1) * PAGE_SIZE;
const paginatedPosts = systemsPosts.slice(startIndex, startIndex + PAGE_SIZE);

const getPageUrl = (page: number) =>
  page === 1 ? listIndexHref : `${listIndexHref}/p/${page}`;

const fragmentsCount = allOriginals.filter(
  (post) => post.data.category === "fragments",
).length;
const projectsCount = allOriginals.filter(
  (post) => post.data.category === "projects",
).length;

const counts = {
  systems: systemsPosts.length,
  fragments: fragmentsCount,
  projects: projectsCount,
};

const tagCountsMap = new Map<string, number>();
for (const post of systemsPosts) {
  const uniqueTags = new Set(post.data.tags ?? []);
  for (const tag of uniqueTags) {
    tagCountsMap.set(tag, (tagCountsMap.get(tag) ?? 0) + 1);
  }
}

const tagCounts = Array.from(tagCountsMap.entries())
  .map(([tag, count]) => ({ tag, count }))
  .sort((a, b) => a.tag.localeCompare(b.tag, "zh-CN"));
---

<MainLayout
  title={`成体系的思考 - 原创（第 ${currentPage} 页）`}
  description={`长文与体系化观点的汇总（第 ${currentPage} 页）`}
  wide={true}
>
  <div class="systems-page">
    <header class="systems-header">
      <p class="eyebrow">原触发</p>
      <h1 class="systems-title">
        <span class="title-icon" aria-hidden="true">💭</span>
        成体系的思考
      </h1>
      <p class="systems-intro">
        深度思考与完整论述的集合地。<br />
        社会观察、技术理解、自我认知——在这里沉淀。
      </p>

      <OriginalsFilter active="systems" counts={counts} />
    </header>

    <div class="originals-layout">
      {
        tagCounts.length > 0 && (
          <aside class="originals-aside" aria-label="标签">
            <div class="originals-aside-card">
              <div class="originals-aside-title">标签</div>
              <nav class="originals-aside-list">
                <a
                  class="tagpill is-active"
                  href={listBaseHref}
                  data-originals-tag=""
                >
                  <span class="tagpill-label">全部</span>
                  <span class="tagpill-count">{counts.systems}</span>
                </a>
                {tagCounts.map((t) => (
                  <a
                    class="tagpill"
                    href={`${listBaseHref}?tag=${encodeURIComponent(t.tag)}`}
                    data-originals-tag={t.tag}
                  >
                    <span class="tagpill-label">{t.tag}</span>
                    <span class="tagpill-count">{t.count}</span>
                  </a>
                ))}
              </nav>
            </div>
          </aside>
        )
      }

      <main class="originals-main">
        <section class="systems-list">
          {
            paginatedPosts.map((post) => (
              <SystemsCard post={post} listHref={listBaseHref} />
            ))
          }
        </section>

        <section class="systems-placeholder" data-originals-empty hidden>
          <div class="placeholder-icon">🏷️</div>
          <h2 class="placeholder-title">没有匹配的原论</h2>
          <p class="placeholder-text">试试切换其他标签，或选择「全部」。</p>
        </section>

        <Pagination
          currentPage={currentPage}
          totalPages={totalPages}
          getPageUrl={getPageUrl}
        />

        <aside class="systems-info">
          <h3 class="info-title">💡 什么会出现在这里？</h3>
          <ul class="info-list">
            <li>对社会现象的深度分析与思考</li>
            <li>技术哲学与工程实践的反思</li>
            <li>个人成长与认知升级的总结</li>
            <li>其他需要完整论述的主题探讨</li>
          </ul>
        </aside>
      </main>
    </div>
  </div>
</MainLayout>
