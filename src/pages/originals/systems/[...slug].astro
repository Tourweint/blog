---
import { getCollection } from "astro:content";
import MainLayout from "../../../layouts/mainlayout.astro";
import TableOfContents from "../../../components/TableOfContents.astro";
import { excerpts } from "../../../utils/excerptsPaths";
import "../../../styles/posts.css";

export async function getStaticPaths() {
  const originals = await getCollection("originals");
  const systemsPosts = originals.filter((post) =>
    post.slug.startsWith("systems/"),
  );

  return systemsPosts.map((post) => ({
    params: { slug: post.slug.replace("systems/", "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();

const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const hasToc = tocHeadings.length > 0;

const backUrl = "/originals/systems/systems";

// 计算阅读时间（若 frontmatter 未提供）
const content = post.body ?? "";
const chineseChars = (content.match(/[\u4e00-\u9fa5]/g) || []).length;
const englishWords = (content.match(/[a-zA-Z]+/g) || []).length;
const wordsPerMinute = 350;
const totalWords = chineseChars + englishWords;
const computedReadingTime = Math.max(1, Math.ceil(totalWords / wordsPerMinute));
const readingTime = post.data.readingTime ?? computedReadingTime;
---

<MainLayout
  title={`${post.data.title} - 多鸣的博客`}
  description={post.data.description || post.data.title}
  type="article"
  publishedTime={post.data.pubDate}
  tags={post.data.tags}
  image={post.data.image}
>
  <div class="post-layout">
    {
      hasToc && (
        <div class="post-sidebar">
          <TableOfContents headings={headings} />
        </div>
      )
    }

    <div class="post-main">
      <nav class="nav-bar">
        <a href={backUrl} class="back-link">← 返回成体系的思考</a>
      </nav>

      <article class="post-detail">
        <h1 class="post-title">{post.data.title}</h1>

        <div class="meta">
          <span class="date-tag"
            >{post.data.pubDate.toLocaleDateString("zh-cn")}</span
          >
          <span class="reading-time">
            <span class="reading-icon">📖</span>
            <span>{readingTime} 分钟阅读</span>
            <span class="word-count">· 约 {totalWords} 字</span>
          </span>
          <div class="meta-categories" id="categories">
            {
              post.data.tags && post.data.tags.length > 0 ? (
                post.data.tags.map((tag) => (
                  <a href={excerpts.category(tag)} class="category-tag">
                    {tag}
                  </a>
                ))
              ) : (
                <a href={excerpts.category("未分类")} class="category-tag">
                  未分类
                </a>
              )
            }
          </div>
        </div>

        <div class="content">
          <Content />
        </div>
      </article>
    </div>
  </div>

  <button
    class="back-to-top"
    id="back-to-top"
    aria-label="返回顶部"
    title="返回顶部"
  >
    <span class="back-to-top-icon">↑</span>
  </button>
</MainLayout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const backToTopBtn = document.getElementById("back-to-top");
    if (!backToTopBtn) return;

    const toggleVisibility = () => {
      if (window.scrollY > 300) {
        backToTopBtn.classList.add("visible");
      } else {
        backToTopBtn.classList.remove("visible");
      }
    };

    window.addEventListener("scroll", toggleVisibility, { passive: true });
    toggleVisibility();

    backToTopBtn.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  });
</script>
