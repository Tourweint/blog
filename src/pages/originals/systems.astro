---
import { getCollection } from "astro:content";
import MainLayout from "../../layouts/mainlayout.astro";
import "../../styles/originals.css";

const posts = await getCollection("posts");
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<MainLayout
  title="成体系的思考 - 原创"
  description="长文与体系化观点的汇总"
  wide={true}
>
  <div class="originals-page">
    <section class="originals-header">
      <h1 class="originals-title">成体系的思考</h1>
      <blockquote class="originals-statement">
        <p>这里汇总了我相对完整、成体系的长篇思考。</p>
        <p>涵盖社会、技术与自我三类主题。</p>
      </blockquote>
    </section>

    <section class="originals-sections">
      <div class="section">
        <div class="section-header">
          <h2 class="section-title">文章列表</h2>
          <p class="section-subtitle">按发布时间倒序</p>
        </div>
        <ul class="originals-list">
          {
            posts.map((post) => (
              <li class="originals-item">
                <a href={`/posts/${post.slug}`} class="originals-link">
                  <span class="item-title">{post.data.title}</span>
                  <span class="item-date">
                    {post.data.pubDate.toLocaleDateString("zh-CN")}
                  </span>
                </a>
                {post.data.description && (
                  <p class="item-desc">{post.data.description}</p>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="originals-note">
      <p class="note-text">📌 该页只做汇总，详细内容请进入具体文章。</p>
    </section>
  </div>
</MainLayout>
