---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Postslayout from "../../layouts/mainlayout.astro";
import "../../styles/posts.css";

const pageSize = 8; // 与分页设置保持一致

// 1. 生成所有文章的路径
export async function getStaticPaths() {
  const blogEntries = await getCollection("posts");
  // 按日期排序，与首页保持一致
  blogEntries.sort(
    (a: CollectionEntry<"posts">, b: CollectionEntry<"posts">) =>
      b.data.pubDate.getTime() - a.data.pubDate.getTime()
  );

  return blogEntries.map((entry, index) => ({
    params: { slug: entry.slug },
    props: {
      entry,
      // 计算文章在第几页
      pageNumber: Math.floor(index / 8) + 1,
    },
  }));
}

// 2. 获取文章内容
const { entry, pageNumber } = Astro.props;
const { Content } = await entry.render();
const maxStars = 5;
const rereadStars = Math.min(
  Math.max(entry.data.rereadStars ?? 0, 0),
  maxStars
);
const starStates = Array.from(
  { length: maxStars },
  (_, index) => index < rereadStars
);

// 处理作者信息（兼容字符串和对象两种格式）
const author = entry.data.author
  ? typeof entry.data.author === "string"
    ? { name: entry.data.author, url: undefined }
    : entry.data.author
  : null;

// 生成返回链接：第一页返回首页，其他页返回对应分页，带上滚动定位参数
const backUrl =
  pageNumber === 1
    ? `/?scrollTo=${entry.slug}`
    : `/page/${pageNumber}?scrollTo=${entry.slug}`;
---

<Postslayout title={entry.data.title} description={entry.data.description}>
  <nav class="nav-bar">
    <a href={backUrl} class="back-link" id="back-home">← 返回首页</a>
  </nav>
  <article class="post-detail">
    <h1 class="post-title">{entry.data.title}</h1>

    <div class="meta">
      <span class="date-tag"
        >{entry.data.pubDate.toLocaleDateString("zh-cn")}</span
      >
      {
        author && (
          <>
            {author.url ? (
              <a
                href={author.url}
                target="_blank"
                rel="noopener noreferrer"
                class="author-link"
              >
                {author.name}
              </a>
            ) : (
              <span class="author-name">{author.name}</span>
            )}
          </>
        )
      }
      <div class="meta-categories" id="categories">
        {
          entry.data.tags && entry.data.tags.length > 0 ? (
            entry.data.tags.map((tag) => (
              <a
                href={`/category/${encodeURIComponent(tag)}`}
                class="category-tag"
              >
                {tag}
              </a>
            ))
          ) : (
            <a href="/category/未分类" class="category-tag">
              未分类
            </a>
          )
        }
      </div>
      {
        rereadStars > 0 && (
          <div class="meta-stars-group">
            <span>推荐星级 :</span>
            <div
              class="meta-stars"
              id="reread-stars"
              role="img"
              aria-label={`推荐星级 ${rereadStars} / ${maxStars}`}
            >
              {starStates.map((filled, index) => (
                <span
                  class={`star${filled ? " star--filled" : ""}`}
                  aria-hidden="true"
                >
                  ★
                </span>
              ))}
            </div>
          </div>
        )
      }
    </div>

    <div class="content">
      <Content />
    </div>
  </article>
</Postslayout>
