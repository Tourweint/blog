---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import MainLayout from "./mainlayout.astro";
import GuestCardMini from "../components/GuestCardMini.astro";
import TableOfContents from "../components/TableOfContents.astro";
import BackLink from "../components/BackLink.astro";
import SourceLink from "../components/SourceLink.astro";
import { excerpts } from "../utils/excerptsPaths";
import "../styles/conversations.css";

interface Props {
  post: CollectionEntry<"conversations">;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const { data } = post;

// 为编者按和金句准备样式类
const hasEditorNote = data.editorNote;
const allPersons = await getCollection("persons");
const toPersonSlug = (id: string) => id.replace(/\.(md|mdx)$/i, "");
const guestPersons = (data.guests || [])
  .map((slug: string) => allPersons.find((p) => toPersonSlug(p.id) === slug))
  .filter((p): p is CollectionEntry<"persons"> => p !== undefined);
const guestNames = guestPersons.map((p) => p?.data.name).join(" × ");

// frontmatter 里的描述字段已取消：SEO 描述取编者按（截断）
const seoDescription = (data.editorNote ?? data.pullQuote ?? data.title).slice(
  0,
  120,
);

// 正文里的说话人标签通常只写名（"**Lex:**"），frontmatter 里是全名（"Lex Fridman"）。
// 找出与 interviewer 对应的那个名字，用来把「提问段」单独排版。
const speakerNames = [
  ...new Set(
    [...(post.body ?? "").matchAll(/^\*\*([^*:：]{1,24})[:：]\*\*/gm)].map((m) =>
      m[1].trim(),
    ),
  ),
];
const interviewerKey = (data.interviewer ?? "").split(/\s+/)[0];
const hostSpeaker = interviewerKey
  ? speakerNames.find(
      (name) =>
        name === data.interviewer ||
        name === interviewerKey ||
        name.startsWith(interviewerKey) ||
        interviewerKey.startsWith(name),
    )
  : undefined;

// readingTime 字段已取消，改用正文字数（中文字符 + 英文单词/数字）
const bodyText = post.body ?? "";
const charCount =
  (bodyText.match(/[\u4e00-\u9fa5]/g) ?? []).length +
  (bodyText.match(/[a-zA-Z0-9]+/g) ?? []).length;
const charLabel = charCount > 0 ? `约 ${charCount.toLocaleString("zh-CN")} 字` : null;
---

<MainLayout
  title={data.title}
  description={seoDescription}
  type="article"
  publishedTime={data.pubDate}
  tags={data.tags}
>
  <article class="conversation-article">
    <nav class="back-nav">
      <BackLink href={excerpts.conversationsIndex} label="返回对话录" />
    </nav>
    <!-- 文章头部 -->

    <header class="article-header">
      <h1 class="article-title">{data.title}</h1>

      <div class="article-meta">
        <span class="byline">
          {
            data.interviewer && (
              <>
                <span class="byline-name">{data.interviewer}</span>
                <span class="byline-sep">×</span>
              </>
            )
          }
          <span class="byline-name">{guestNames}</span>
        </span>
        <span class="pub-date">
          {
            new Date(data.pubDate).toLocaleDateString("zh-CN", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })
          }
        </span>
        {charLabel && <span class="word-count">{charLabel}</span>}
      </div>

      {
        data.pullQuote && (
          <blockquote class="featured-quote">
            <p>{data.pullQuote}</p>
          </blockquote>
        )
      }
    </header>

    <div class="article-layout">
      <!-- 主内容区 -->
      <div class="article-content">
        {
          hasEditorNote && (
            <div class="editor-note">
              <h3 class="note-title">编者按</h3>
              <div class="note-content">{data.editorNote}</div>
            </div>
          )
        }

        <!-- 正文内容 -->
        <div class="markdown-body content">
          <Content />
        </div>

        <!-- 文章底部信息 -->
        <footer class="article-footer">
          <div class="footer-content">
            {
              data.tags && data.tags.length > 0 && (
                <div class="article-tags">
                  <strong>相关话题：</strong>
                  <div class="tags-list">
                    {data.tags.map((tag) => (
                      <a
                        href={`${excerpts.conversationsIndex}?tag=${encodeURIComponent(tag)}`}
                        class="tag-link"
                      >
                        {tag}
                      </a>
                    ))}
                  </div>
                </div>
              )
            }
          </div>
        </footer>
      </div>

      <!-- 侧边栏：嘉宾信息 -->
      <aside class="article-sidebar">
        {data.sourceUrl && <SourceLink href={data.sourceUrl} />}

        {
          guestPersons.length > 0 && (
            <section class="guests-section">
              <h3>对话嘉宾</h3>
              <div class="guests-list">
                {guestPersons.map((person) => (
                  <GuestCardMini person={person} />
                ))}
              </div>
            </section>
          )
        }

        {
          headings && headings.length > 0 && (
            <TableOfContents headings={headings} />
          )
        }

        <!-- 分享按钮 -->
        <section class="share-section">
          <h3>分享</h3>
          <div class="share-buttons">
            <a
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(data.title)}&url=${encodeURIComponent(Astro.url.href)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="share-btn twitter"
              title="分享到 Twitter"
            >
              𝕏
            </a>
            <a
              href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(Astro.url.href)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="share-btn facebook"
              title="分享到 Facebook"
            >
              f
            </a>
            <button
              class="share-btn copy"
              onclick="navigator.clipboard.writeText(window.location.href); alert('链接已复制')"
              title="复制链接"
              aria-label="复制链接"
            >
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
              </svg>
            </button>
          </div>
        </section>
      </aside>
    </div>
  </article>
</MainLayout>

{
  hostSpeaker && (
    <style
      is:inline
      set:html={`
        /*
          问题当「准标题」：语义仍是段落（不进目录、不破坏 h3 主题层级），
          但视觉上比回答重一档——字号略大、字重 600、颜色回到正文色。
        */
        .conversation-article .markdown-body > p[data-speaker="${hostSpeaker}"] {
          margin-top: 2.6em;
          margin-bottom: 0.5em;
          padding-left: 16px;
          border-left: 3px solid color-mix(in oklab, var(--c-text) 32%, transparent);
          font-size: 1.04em;
          font-weight: 600;
          color: var(--c-text);
          line-height: 1.75;
        }

        /* 章节标题后的第一个问题：紧贴标题，别把标题和内容拉开 */
        .conversation-article .markdown-body > h3 + p[data-speaker="${hostSpeaker}"] {
          margin-top: 1.1em;
        }

        /* 问题前的人名：与回答的人名、与正文同号，只靠颜色和字重区分 */
        .conversation-article .markdown-body > p[data-speaker="${hostSpeaker}"] > strong.speaker-name {
          font-size: 1.125rem;
          font-weight: 600;
          letter-spacing: 0.02em;
          color: var(--color-text-secondary);
        }

        .conversation-article .markdown-body > p[data-speaker]:not([data-speaker="${hostSpeaker}"]) {
          margin-top: 1.2em;
        }
      `}
    />
  )
}
