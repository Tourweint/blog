---
// src/layouts/MainLayout.astro
import "../styles/global.css";
import { excerpts } from "../utils/excerptsPaths";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  tags?: string[];
  wide?: boolean;
}

const {
  title = "Tourweint/多鸣",
  description = "思维、哲学与成长的长期记录",
  image = "/favicon/favicon-96x96.png",
  type = "website",
  publishedTime,
  tags = [],
} = Astro.props;

// 站点域名：优先使用 astro.config.mjs 中的 site（Astro.site），避免多处硬编码
const site = Astro.site ?? new URL("https://tourweint.shop");
const canonicalURL = new URL(Astro.url.pathname, site);
const ogImage = image.startsWith("http")
  ? image
  : new URL(image, site).toString();

const pathname = Astro.url.pathname;
const pathSegments = pathname.split("/").filter(Boolean);

const isHome = pathname === "/" || pathname === "/index";
const isOriginals = pathname.startsWith("/originals");
const isExcerpts = pathname.startsWith("/excerpts");
const isAbout = pathname.startsWith("/about");
const isSearch = pathname.startsWith("/search");

const bodyClasses: string[] = ["site-body"];

if (pathname === "/") {
  bodyClasses.push("page-home");
}

if (pathname.startsWith("/about/about")) {
  bodyClasses.push("page-about");
}

if (pathname.startsWith("/about/tools")) {
  bodyClasses.push("page-tools");
}

if (pathname.startsWith("/search")) {
  bodyClasses.push("page-search");
}

if (
  pathname.startsWith("/excerpts/posts") ||
  pathname.startsWith("/excerpts/category")
) {
  bodyClasses.push("page-excerpts-posts");
}

if (pathname.startsWith("/excerpts/notes")) {
  bodyClasses.push("page-excerpts-notes");
}

if (pathname.startsWith("/excerpts/conversations")) {
  bodyClasses.push("page-excerpts-conversations");
}

if (pathname.startsWith("/excerpts/persons")) {
  bodyClasses.push("page-excerpts-persons");
}

if (pathname.startsWith("/excerpts")) {
  bodyClasses.push("page-excerpts");
}

if (pathname === "/excerpts" || pathname === "/excerpts/") {
  bodyClasses.push("page-excerpts-index");
}

// Originals（原创）频道：单独的页面作用域
if (pathname.startsWith("/originals")) {
  bodyClasses.push("page-originals");
}

if (pathname === "/originals" || pathname === "/originals/") {
  bodyClasses.push("page-originals-index");
}

if (
  pathSegments[0] === "originals" &&
  pathSegments[1] === "systems" &&
  pathSegments[2] === "systems"
) {
  bodyClasses.push("page-originals-systems");
}

if (
  pathSegments[0] === "originals" &&
  pathSegments[1] === "fragments" &&
  pathSegments[2] === "fragments"
) {
  bodyClasses.push("page-originals-fragments");
}

if (
  pathSegments[0] === "originals" &&
  pathSegments[1] === "projects" &&
  pathSegments[2] === "projects"
) {
  bodyClasses.push("page-originals-projects");
}

const isOriginalsDetail =
  pathSegments[0] === "originals" &&
  pathSegments.length >= 3 &&
  // 排除列表页：/originals/{category}/{category}
  pathSegments[1] !== pathSegments[2];

if (isOriginalsDetail) {
  bodyClasses.push("page-originals-detail");
}

// 详情页（文章版式）：摘录详情 / 原创详情
if (
  (pathSegments[0] === "excerpts" &&
    pathSegments[1] === "posts" &&
    pathSegments[2] === "page") ||
  isOriginalsDetail
) {
  bodyClasses.push("page-article");
}

const bodyClass = bodyClasses.join(" ");
---

<html lang="zh-cn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- 基础 SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="多鸣" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link
      rel="alternate icon"
      type="image/png"
      href="/favicon/favicon-96x96.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/favicon/apple-touch-icon.png"
    />
    <link rel="manifest" href="/favicon/site.webmanifest" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Tourweint/多鸣" />
    <meta property="og:locale" content="zh_CN" />
    {
      publishedTime && (
        <meta
          property="article:published_time"
          content={publishedTime.toISOString()}
        />
      )
    }
    {
      tags.length > 0 &&
        tags.map((tag) => <meta property="article:tag" content={tag} />)
    }

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- 其他 SEO 标签 -->
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />
  </head>
  <body class={bodyClass}>
    <header class="navbar" id="site-navbar">
      <nav class="nav-container">
        <a href="/" class="logo">
          <span class="logo-text">Tourweint</span>
        </a>

        <button
          class="nav-toggle"
          type="button"
          aria-label="打开导航菜单"
          aria-controls="mobile-drawer"
          aria-expanded="false"
          data-nav-toggle
        >
          <span class="nav-toggle-icon" aria-hidden="true">☰</span>
        </button>

        <ul class="nav-links">
          <li>
            <a href="/" class={`nav-link${isHome ? " is-active" : ""}`}>
              首页
            </a>
          </li>
          <li>
            <a
              href="/originals/"
              class={`nav-link${isOriginals ? " is-active" : ""}`}
            >
              原触发
            </a>
          </li>
          <li>
            <a
              href={excerpts.rootHref}
              class={`nav-link${isExcerpts ? " is-active" : ""}`}
            >
              摘录
            </a>
          </li>
          <li>
            <a href="/search" class={`nav-link${isSearch ? " is-active" : ""}`}>
              搜索
            </a>
          </li>
          <li>
            <a
              href="/about/about"
              class={`nav-link${isAbout ? " is-active" : ""}`}
            >
              关于
            </a>
          </li>
        </ul>
      </nav>
    </header>

    <div class="drawer-overlay" data-drawer-overlay hidden></div>
    <aside
      class="mobile-drawer"
      id="mobile-drawer"
      aria-label="站点导航"
      hidden
    >
      <nav class="drawer-nav">
        <a class={`drawer-link${isHome ? " is-active" : ""}`} href="/">
          首页
        </a>
        <a
          class={`drawer-link${isOriginals ? " is-active" : ""}`}
          href="/originals/"
        >
          原触发
        </a>
        <a
          class={`drawer-link${isExcerpts ? " is-active" : ""}`}
          href={excerpts.rootHref}
        >
          摘录
        </a>
        <a class={`drawer-link${isSearch ? " is-active" : ""}`} href="/search">
          搜索
        </a>
        <a
          class={`drawer-link${isAbout ? " is-active" : ""}`}
          href="/about/about"
        >
          关于
        </a>
      </nav>
    </aside>

    <main class="page-content" data-pagefind-body>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-container">
        <div class="footer-col">
          <h3>关于本站</h3>
          <p>
            这里是我记录学习和生活的地方，没有复杂的算法推荐，只有纯粹的文字和代码，如有侵权立即联系我以删除。
          </p>
        </div>

        <div class="footer-col">
          <h3>友情链接 / 社交</h3>
          <div class="footer-links">
            <a href="https://github.com/Tourweint" target="_blank"
              >GitHub (我的代码仓库)</a
            >
            <a href="mailto:647575404@qq.com"
              >Email：647575404@qq.com (联系我)</a
            >
            <a href="https://developer.mozilla.org/zh-CN/" target="_blank"
              >MDN Web 文档</a
            >
          </div>
        </div>

        <div class="copyright">
          &copy; 2025 Tourweint's Blog. All rights reserved.
        </div>
      </div>
    </footer>

    <script>
      {
        const navbar = document.getElementById(
          "site-navbar",
        ) as HTMLElement | null;
        const toggle = document.querySelector(
          "[data-nav-toggle]",
        ) as HTMLButtonElement | null;
        const drawer = document.getElementById(
          "mobile-drawer",
        ) as HTMLElement | null;
        const overlay = document.querySelector(
          "[data-drawer-overlay]",
        ) as HTMLElement | null;

        if (navbar) {
          let lastY = window.scrollY;
          let ticking = false;
          const threshold = 8;

          const onScroll = () => {
            const currentY = window.scrollY;
            const delta = currentY - lastY;

            // 抽屉打开时，保持导航栏可见
            if (document.body.classList.contains("drawer-open")) {
              navbar.classList.remove("navbar--hidden");
              lastY = currentY;
              return;
            }

            if (Math.abs(delta) > threshold) {
              if (delta > 0 && currentY > 80) {
                navbar.classList.add("navbar--hidden");
              } else if (delta < 0) {
                navbar.classList.remove("navbar--hidden");
              }
              lastY = currentY;
            }
          };

          window.addEventListener(
            "scroll",
            () => {
              if (!ticking) {
                window.requestAnimationFrame(() => {
                  onScroll();
                  ticking = false;
                });
                ticking = true;
              }
            },
            { passive: true },
          );
        }

        const openDrawer = () => {
          if (!toggle || !drawer || !overlay) return;
          document.body.classList.add("drawer-open");
          drawer.hidden = false;
          overlay.hidden = false;
          toggle.setAttribute("aria-expanded", "true");
        };

        const closeDrawer = () => {
          if (!toggle || !drawer || !overlay) return;
          document.body.classList.remove("drawer-open");
          toggle.setAttribute("aria-expanded", "false");

          // 等动画结束再 hidden，避免闪烁
          window.setTimeout(() => {
            if (!document.body.classList.contains("drawer-open")) {
              drawer.hidden = true;
              overlay.hidden = true;
            }
          }, 220);
        };

        if (toggle && drawer && overlay) {
          toggle.addEventListener("click", () => {
            const isOpen = document.body.classList.contains("drawer-open");
            isOpen ? closeDrawer() : openDrawer();
          });

          overlay.addEventListener("click", closeDrawer);

          window.addEventListener("keydown", (e) => {
            if (e.key === "Escape") closeDrawer();
          });

          drawer.addEventListener("click", (e) => {
            const target = e.target;
            if (target instanceof HTMLAnchorElement) closeDrawer();
          });
        }
      }
    </script>
  </body>
</html>
