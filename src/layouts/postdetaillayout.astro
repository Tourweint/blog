---
import ContentDetailLayout from "./contentdetaillayout.astro";
import { excerpts } from "../utils/excerptsPaths";
import type { ContentDetailLayoutProps } from "./contentdetail.types";

interface Props extends ContentDetailLayoutProps {}

const {
  tagsBaseHref = excerpts.categoryBaseHref,
  backLabel = "返回摘录页",
  ...rest
} = Astro.props;
---

<ContentDetailLayout
  {...rest}
  tagsBaseHref={tagsBaseHref}
  backLabel={backLabel}
>
  <slot />
</ContentDetailLayout>
