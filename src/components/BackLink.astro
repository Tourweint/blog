---
type Props = {
  href: string;
  label: string;
  className?: string;
  ariaLabel?: string;
};

const { href, label, className = "", ariaLabel } = Astro.props;
const classes = ["back-link", className].filter(Boolean).join(" ");
---

<a href={href} class={classes} aria-label={ariaLabel ?? label}>
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="back-icon"
    aria-hidden="true"
  >
    <path d="M19 12H5M12 19l-7-7 7-7"></path>
  </svg>
  <span>{label}</span>
</a>
