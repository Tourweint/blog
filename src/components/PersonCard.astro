---
import type { CollectionEntry } from "astro:content";

interface Props {
  person: CollectionEntry<"persons">;
}

const { person } = Astro.props;
const { data, slug } = person;
---

<article class="person-card">
  <div class="card-header">
    {data.avatar && (
      <div class="avatar">
        <img src={data.avatar} alt={data.name} loading="lazy" />
      </div>
    )}
    <div class="header-info">
      <h3 class="person-name">
        <a href={`/persons/${slug}`}>{data.name}</a>
      </h3>
      {data.nameEn && data.nameEn !== data.name && (
        <span class="name-en">{data.nameEn}</span>
      )}
      {data.role && <p class="person-role">{data.role}</p>}
    </div>
  </div>

  {data.bio && (
    <p class="person-bio">{data.bio}</p>
  )}

  <div class="card-footer">
    {data.tags && data.tags.length > 0 && (
      <div class="tags">
        {data.tags.slice(0, 3).map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    )}
    <a href={`/persons/${slug}`} class="view-link">
      查看详情
      <svg class="arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </a>
  </div>

  <a href={`/persons/${slug}`} class="card-link-overlay" aria-hidden="true"></a>
</article>

<style>
  .person-card {
    position: relative;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.5rem;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .person-card:hover {
    border-color: rgba(154, 107, 47, 0.4);
    box-shadow: 0 10px 26px rgba(154, 107, 47, 0.12);
    transform: translateY(-2px);
  }

  .card-header {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .avatar {
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--color-bg-tertiary, #f0f0f0);
    border: 2px solid var(--color-border);
  }

  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .header-info {
    flex: 1;
    min-width: 0;
  }

  .person-name {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .person-name a {
    color: var(--color-text);
    text-decoration: none;
    position: relative;
    z-index: 2;
  }

  .person-name a:hover {
    color: #9a6b2f;
  }

  .name-en {
    display: block;
    font-size: 0.85rem;
    color: var(--color-text-tertiary);
    margin-top: 0.15rem;
  }

  .person-role {
    margin: 0.4rem 0 0;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  .person-bio {
    flex: 1;
    margin: 0 0 1rem;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .tag {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    background: rgba(238, 242, 247, 0.6);
    color: #5a6b7d;
    border-radius: 12px;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .view-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.85rem;
    color: #9a6b2f;
    text-decoration: none;
    font-weight: 500;
    position: relative;
    z-index: 2;
    white-space: nowrap;
  }

  .view-link:hover {
    text-decoration: underline;
  }

  .arrow-icon {
    width: 14px;
    height: 14px;
  }

  .card-link-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  @media (max-width: 640px) {
    .person-card {
      padding: 1rem;
    }

    .avatar {
      width: 60px;
      height: 60px;
    }

    .card-header {
      gap: 0.75rem;
    }

    .person-name {
      font-size: 1.05rem;
    }

    .card-footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
  }
</style>
