---
import type { CollectionEntry } from "astro:content";
import { excerpts, toIdSlug } from "../utils/excerptsPaths";

interface Props {
  person: CollectionEntry<"persons">;
}

const { person } = Astro.props;
const { data } = person;
const personHref = excerpts.personDetail(toIdSlug(person.id));

// 没有头像时用姓名首字占位，避免卡片顶部出现空洞
const initial = data.name.trim().slice(0, 1);
const nameEn = data.nameEn && data.nameEn !== data.name ? data.nameEn : null;
const linkLabel = data.role ? `${data.name}，${data.role}` : data.name;
---

<article class="person-card">
  <a class="person-card__hit" href={personHref} aria-label={linkLabel}>
    <div class="person-card__head">
      {
        data.avatar ? (
          <img
            class="person-card__avatar"
            src={data.avatar}
            alt=""
            width="48"
            height="48"
            loading="lazy"
          />
        ) : (
          <span
            class="person-card__avatar person-card__avatar--fallback"
            aria-hidden="true">{initial}</span>
        )
      }

      <div class="person-card__id">
        <h3 class="person-card__name">
          {data.name}
          {nameEn && <span class="person-card__name-en">{nameEn}</span>}
        </h3>
        {data.role && <p class="person-card__role">{data.role}</p>}
      </div>

      <svg
        class="person-card__arrow"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M7 17 17 7M9 7h8v8"></path>
      </svg>
    </div>

    {data.bio && <p class="person-card__bio">{data.bio}</p>}
  </a>
</article>

<style>
  /*
    人物卡：三行信息（头像+姓名+身份 / 两行简介），
    去掉标签与「查看详情」，整卡即链接。
  */
  .person-card {
    height: 100%;
    background: var(--c-surface);
    border: 1px solid var(--c-rule);
    border-radius: var(--c-radius);
    box-shadow: var(--c-shadow);
    transition:
      transform var(--c-dur) var(--c-ease),
      border-color var(--c-dur) var(--c-ease),
      box-shadow var(--c-dur) var(--c-ease),
      background-color var(--c-dur) var(--c-ease);
  }

  .person-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--c-rule) 180%, transparent);
    background: color-mix(in oklab, var(--c-text) 1.5%, var(--c-surface));
    box-shadow: var(--c-shadow-hover);
  }

  .person-card__hit {
    display: flex;
    flex-direction: column;
    gap: 14px;
    height: 100%;
    padding: 20px 22px;
    border-radius: inherit;
    color: inherit;
    text-decoration: none;
  }

  .person-card__head {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .person-card__avatar {
    flex: 0 0 auto;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    background: color-mix(in oklab, var(--c-text) 6%, transparent);
  }

  .person-card__avatar--fallback {
    display: grid;
    place-items: center;
    border: 1px solid var(--c-rule);
    font-family: var(--t-font-serif);
    font-size: 17px;
    font-weight: 600;
    color: var(--c-muted);
  }

  .person-card__id {
    flex: 1;
    min-width: 0;
  }

  .person-card__name {
    margin: 0;
    font-family: var(--t-font-serif);
    font-size: 17px;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: 0.01em;
    color: var(--c-text);
  }

  .person-card__name-en {
    margin-left: 0.45em;
    font-family: var(--t-font-sans);
    font-size: 0.75em;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--c-muted);
  }

  /* 身份单行截断：`role` 常常是一整串头衔，换行会撑高卡片 */
  .person-card__role {
    margin: 4px 0 0;
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--c-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .person-card__arrow {
    flex: 0 0 auto;
    width: 16px;
    height: 16px;
    color: var(--c-muted);
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity var(--c-dur) var(--c-ease),
      transform var(--c-dur) var(--c-ease);
  }

  .person-card:hover .person-card__arrow,
  .person-card__hit:focus-visible .person-card__arrow {
    opacity: 1;
    transform: none;
  }

  /*
    简介固定两行。要点：此处不再使用 flex: 1。
    旧版把 flex-grow 加在被截断的元素上，元素高度被撑到 2 行以上，
    文字在第 2 行被截断出省略号，但下面还露出半行——即「两行半」。
  */
  .person-card__bio {
    margin: 0;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--c-muted);
    overflow-wrap: anywhere;
  }

  @media (max-width: 480px) {
    .person-card__hit {
      padding: 18px;
    }
  }
</style>
