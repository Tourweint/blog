---
import type { CollectionEntry } from "astro:content";
import { excerpts, toIdSlug } from "../utils/excerptsPaths";

interface Props {
  person: CollectionEntry<"persons">;
}

const { person } = Astro.props;
const { data } = person;
const personSlug = toIdSlug(person.id);
const personHref = excerpts.personDetail(personSlug);
---

<article class="person-card">
  <div class="card-header">
    {
      data.avatar && (
        <div class="avatar">
          <img src={data.avatar} alt={data.name} loading="lazy" />
        </div>
      )
    }
    <div class="header-info">
      <h3 class="person-name">
        <a href={personHref}>{data.name}</a>
      </h3>
      {
        data.nameEn && data.nameEn !== data.name && (
          <span class="name-en">{data.nameEn}</span>
        )
      }
      {data.role && <p class="person-role">{data.role}</p>}
    </div>
  </div>

  {data.bio && <p class="person-bio">{data.bio}</p>}

  <div class="card-footer">
    {
      data.tags && data.tags.length > 0 && (
        <div class="tags">
          {data.tags.slice(0, 3).map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )
    }
    <a href={personHref} class="view-link">
      查看详情
      <svg
        class="arrow-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M5 12h14M12 5l7 7-7 7"></path>
      </svg>
    </a>
  </div>

  <a href={personHref} class="card-link-overlay" aria-hidden="true"></a>
</article>

<style>
  .person-card {
    position: relative;
    background: var(--c-surface);
    border: 1px solid var(--c-rule);
    border-radius: 12px;
    padding: 1.5rem;
    box-shadow: var(--c-shadow);
    transition: all var(--c-dur) var(--c-ease);
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .person-card:hover {
    border-color: rgba(0, 0, 0, 0.18);
    box-shadow: var(--c-shadow-hover);
    transform: translateY(-1px);
  }

  .card-header {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .avatar {
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    overflow: hidden;
    background: color-mix(in oklab, var(--c-text) 6%, transparent);
    border: 1px solid var(--c-rule);
  }

  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .header-info {
    flex: 1;
    min-width: 0;
  }

  .person-name {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.3;
    font-family: var(--t-font-serif);
  }

  .person-name a {
    color: var(--c-text);
    text-decoration: none;
    position: relative;
    z-index: 2;
  }

  .person-name a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .name-en {
    display: block;
    font-size: 0.85rem;
    color: var(--c-muted);
    margin-top: 0.15rem;
  }

  .person-role {
    margin: 0.4rem 0 0;
    font-size: 0.9rem;
    color: var(--c-muted);
    font-weight: 500;
  }

  .person-bio {
    flex: 1;
    margin: 0 0 1rem;
    font-size: 0.9rem;
    color: var(--c-muted);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--c-rule);
  }

  .tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .tag {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    background: color-mix(in oklab, var(--c-text) 6%, transparent);
    color: var(--c-muted);
    border-radius: 12px;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .view-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.85rem;
    color: var(--c-text);
    text-decoration: none;
    font-weight: 500;
    position: relative;
    z-index: 2;
    white-space: nowrap;
  }

  .view-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .view-link:focus-visible {
    outline: 3px solid var(--c-focus);
    outline-offset: 2px;
    border-radius: 10px;
  }

  .arrow-icon {
    width: 14px;
    height: 14px;
  }

  .card-link-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  @media (max-width: 640px) {
    .person-card {
      padding: 1rem;
    }

    .avatar {
      width: 60px;
      height: 60px;
    }

    .card-header {
      gap: 0.75rem;
    }

    .person-name {
      font-size: 1.05rem;
    }

    .card-footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
  }
</style>
