---
import type { CollectionEntry } from "astro:content";

type Props = {
  post: CollectionEntry<"originals">;
};

const { post } = Astro.props;
---

<a
  class="systems-card"
  href={`/originals/${post.slug}`}
  aria-label={`打开原论：${post.data.title}`}
>
  <header class="header">
    <h2 class="title">{post.data.title}</h2>
    {post.data.featured && <span class="badge">推荐</span>}
  </header>

  {post.data.description && <p class="summary">{post.data.description}</p>}

  <footer class="meta">
    <time datetime={post.data.pubDate.toISOString()}>
      {
        post.data.pubDate.toLocaleDateString("zh-CN", {
          year: "numeric",
          month: "2-digit",
          day: "2-digit",
        })
      }
    </time>
    {post.data.readingTime && <span class="dot">·</span>}
    {post.data.readingTime && <span>{post.data.readingTime} 分钟阅读</span>}

    {post.data.tags.length > 0 && <span class="dot">·</span>}
    {
      post.data.tags.length > 0 && (
        <span class="tags" aria-label="标签">
          {post.data.tags.slice(0, 4).map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </span>
      )
    }
  </footer>
</a>

<style>
  .systems-card {
    display: block;
    background: var(--c-surface);
    border: 1px solid var(--c-rule);
    border-radius: var(--c-radius);
    padding: 1.5rem 1.6rem;
    box-shadow: var(--c-shadow);
    transition: all var(--c-dur) var(--c-ease);
    text-decoration: none;
  }

  .systems-card:hover {
    transform: translateY(-1px);
    box-shadow: var(--c-shadow-hover);
    border-color: rgba(0, 0, 0, 0.18);
  }

  .header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .title {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 650;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--c-text);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
    background: rgba(0, 0, 0, 0.06);
    color: var(--c-text);
    white-space: nowrap;
  }

  .summary {
    margin: 0.5rem 0 0;
    color: var(--c-muted);
    line-height: 1.75;
    font-size: 0.98rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.95rem;
    color: var(--c-muted);
    font-size: 0.86rem;
  }

  .dot {
    margin: 0 0.15rem;
  }

  .tags {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
  }

  .tag {
    padding: 0.18rem 0.5rem;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.04);
    color: var(--c-muted);
    font-size: 0.78rem;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .systems-card {
      padding: 1.25rem;
    }

    .header {
      flex-direction: column;
      align-items: flex-start;
    }

    .title {
      font-size: 1.18rem;
    }
  }
</style>
