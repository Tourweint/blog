---
import type { CollectionEntry } from "astro:content";

type Props = {
  post: CollectionEntry<"originals">;
  listHref: string;
};

const { post, listHref } = Astro.props;

const pickStatus = (tags: string[]): "done" | "wip" | undefined => {
  const lowered = tags.map((t) => t.toLowerCase());
  if (
    lowered.some(
      (t) =>
        t === "wip" ||
        t === "todo" ||
        t.includes("进行中") ||
        t.includes("开发中"),
    )
  )
    return "wip";
  if (
    lowered.some(
      (t) =>
        t === "done" ||
        t.includes("已上线") ||
        t.includes("完成") ||
        t.includes("发布"),
    )
  )
    return "done";
  return undefined;
};

const status = pickStatus(post.data.tags);
const description = post.data.description;
const displayStatus = post.data.status ?? status;

const displayTags = post.data.tags.filter((t) => {
  const lowered = t.toLowerCase();
  return lowered !== "wip" && lowered !== "todo" && lowered !== "done";
});

const tagHref = (tag: string) => `${listHref}?tag=${encodeURIComponent(tag)}`;
---

<article
  class="project-card"
  data-originals-item
  data-tags={JSON.stringify(displayTags)}
>
  <a
    class="stretched-link"
    href={`/originals/${post.slug}`}
    aria-label={`打开项目：${post.data.title}`}></a>

  <header class="header">
    <div class="title-row">
      <h2 class="title">
        {post.data.title}
      </h2>
      {post.data.featured && <span class="badge">推荐</span>}
    </div>

    {
      displayStatus && (
        <span class={`status status-${displayStatus}`}>
          {displayStatus === "done" ? "Done" : "WIP"}
        </span>
      )
    }
  </header>

  {description && <p class="summary">{description}</p>}

  <footer class="meta">
    <time datetime={post.data.pubDate.toISOString()}>
      {
        post.data.pubDate.toLocaleDateString("zh-CN", {
          year: "numeric",
          month: "2-digit",
          day: "2-digit",
        })
      }
    </time>
    {post.data.readingTime && <span class="dot">·</span>}
    {post.data.readingTime && <span>{post.data.readingTime} 分钟阅读</span>}

    {displayTags.length > 0 && <span class="dot">·</span>}
    {
      displayTags.length > 0 && (
        <span class="tags" aria-label="标签">
          {displayTags.slice(0, 4).map((tag) => (
            <a
              class="tag"
              href={tagHref(tag)}
              data-originals-tag={tag}
              aria-label={`按标签筛选：${tag}`}
            >
              {tag}
            </a>
          ))}
        </span>
      )
    }
  </footer>
</article>

<style>
  .project-card {
    position: relative;
    background: var(--c-surface);
    border: 1px solid var(--c-rule);
    border-radius: var(--c-radius);
    padding: 1.5rem 1.6rem;
    box-shadow: var(--c-shadow);
    transition: all var(--c-dur) var(--c-ease);
    cursor: pointer;
  }

  .stretched-link {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    z-index: 1;
    display: block;
  }

  .stretched-link:focus-visible {
    outline: 3px solid var(--c-focus);
    outline-offset: 2px;
  }

  .project-card > :not(.stretched-link) {
    position: relative;
    z-index: 2;
  }

  .project-card:hover {
    transform: translateY(-1px);
    box-shadow: var(--c-shadow-hover);
    border-color: rgba(0, 0, 0, 0.18);
  }

  .header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .title-row {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    flex: 1;
  }

  .title {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 650;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--c-text);
    font-family: var(--t-font-serif);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--c-text);
    background: rgba(0, 0, 0, 0.06);
    white-space: nowrap;
  }

  .status {
    display: inline-flex;
    align-items: center;
    height: 28px;
    padding: 0 0.7rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .status-done {
    color: var(--c-text);
    background: rgba(0, 0, 0, 0.04);
    border: 1px solid rgba(0, 0, 0, 0.1);
  }

  .status-wip {
    color: var(--c-text);
    background: rgba(0, 0, 0, 0.04);
    border: 1px solid rgba(0, 0, 0, 0.1);
  }

  .summary {
    margin: 0.65rem 0 0;
    color: var(--c-muted);
    line-height: 1.75;
    font-size: 0.98rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.95rem;
    color: var(--c-muted);
    font-size: 0.86rem;
  }

  .dot {
    margin: 0 0.15rem;
  }

  .tags {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
  }

  .tag {
    position: relative;
    z-index: 3;
    padding: 0.18rem 0.5rem;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.04);
    color: var(--c-muted);
    font-size: 0.78rem;
    font-weight: 500;
    text-decoration: none;
    transition: all var(--c-dur) var(--c-ease);
  }

  .tag:hover {
    color: var(--c-text);
  }

  .tag:focus-visible {
    outline: 3px solid var(--c-focus);
    outline-offset: 2px;
  }

  @media (max-width: 768px) {
    .project-card {
      padding: 1.25rem;
    }

    .header {
      flex-direction: column;
      align-items: flex-start;
    }

    .title-row {
      flex-direction: column;
      gap: 0.35rem;
    }

    .title {
      font-size: 1.18rem;
    }
  }
</style>
