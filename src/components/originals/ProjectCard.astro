---
import type { CollectionEntry } from "astro:content";

type Props = {
  post: CollectionEntry<"originals">;
};

const { post } = Astro.props;

const pickStatus = (tags: string[]): "done" | "wip" | undefined => {
  const lowered = tags.map((t) => t.toLowerCase());
  if (
    lowered.some(
      (t) =>
        t === "wip" ||
        t === "todo" ||
        t.includes("进行中") ||
        t.includes("开发中"),
    )
  )
    return "wip";
  if (
    lowered.some(
      (t) =>
        t === "done" ||
        t.includes("已上线") ||
        t.includes("完成") ||
        t.includes("发布"),
    )
  )
    return "done";
  return undefined;
};

const status = pickStatus(post.data.tags);
const description = post.data.description;
const githubUrl = post.data.githubUrl;
const demoUrl = post.data.demoUrl;
const displayStatus = post.data.status ?? status;

const displayTags = post.data.tags.filter((t) => {
  const lowered = t.toLowerCase();
  return lowered !== "wip" && lowered !== "todo" && lowered !== "done";
});
---

<article class="project-card">
  <a
    class="stretched-link"
    href={`/originals/${post.slug}`}
    aria-label={`打开项目：${post.data.title}`}></a>

  <header class="header">
    <div class="title-row">
      <h2 class="title">
        {post.data.title}
      </h2>
      {post.data.featured && <span class="badge">推荐</span>}
    </div>

    {
      displayStatus && (
        <span class={`status status-${displayStatus}`}>
          {displayStatus === "done" ? "Done" : "WIP"}
        </span>
      )
    }
  </header>

  {description && <p class="summary">{description}</p>}

  <footer class="footer">
    <div class="meta">
      <time datetime={post.data.pubDate.toISOString()}>
        {
          post.data.pubDate.toLocaleDateString("zh-CN", {
            year: "numeric",
            month: "2-digit",
            day: "2-digit",
          })
        }
      </time>
      {post.data.readingTime && <span class="dot">·</span>}
      {post.data.readingTime && <span>{post.data.readingTime} 分钟阅读</span>}
    </div>

    {
      displayTags.length > 0 && (
        <div class="tags" aria-label="Tech Stack">
          {displayTags.slice(0, 6).map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )
    }

    {
      (githubUrl || demoUrl) && (
        <div class="links" aria-label="Project Links">
          {githubUrl && (
            <a
              class="link-btn"
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub
            </a>
          )}
          {demoUrl && (
            <a
              class="link-btn link-primary"
              href={demoUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Demo
            </a>
          )}
        </div>
      )
    }
  </footer>
</article>

<style>
  .project-card {
    position: relative;
    background: var(--c-surface);
    border: 1px solid var(--c-rule);
    border-radius: var(--c-radius);
    padding: 1.5rem 1.6rem;
    box-shadow: var(--c-shadow);
    transition: all var(--c-dur) var(--c-ease);
    cursor: pointer;
  }

  .stretched-link {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    z-index: 0;
  }

  .stretched-link:focus-visible {
    outline: 3px solid var(--c-focus);
    outline-offset: 2px;
  }

  .project-card > :not(.stretched-link) {
    position: relative;
    z-index: 1;
  }

  .project-card:hover {
    transform: translateY(-1px);
    box-shadow: var(--c-shadow-hover);
    border-color: rgba(0, 0, 0, 0.18);
  }

  .header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .title-row {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    flex: 1;
  }

  .title {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 650;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--c-text);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--c-text);
    background: rgba(0, 0, 0, 0.06);
    white-space: nowrap;
  }

  .status {
    display: inline-flex;
    align-items: center;
    height: 28px;
    padding: 0 0.7rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .status-done {
    color: var(--c-text);
    background: rgba(0, 0, 0, 0.04);
    border: 1px solid rgba(0, 0, 0, 0.1);
  }

  .status-wip {
    color: var(--c-text);
    background: rgba(0, 0, 0, 0.04);
    border: 1px solid rgba(0, 0, 0, 0.1);
  }

  .summary {
    margin: 0.65rem 0 0;
    color: var(--c-muted);
    line-height: 1.75;
    font-size: 0.98rem;
  }

  .footer {
    margin-top: 1rem;
    display: grid;
    gap: 0.75rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .link-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 34px;
    padding: 0 0.85rem;
    border-radius: 10px;
    font-size: 0.86rem;
    font-weight: 650;
    text-decoration: none;
    color: var(--c-text);
    background: rgba(0, 0, 0, 0.04);
    border: 1px solid rgba(0, 0, 0, 0.1);
    transition: all var(--c-dur) var(--c-ease);
  }

  .link-btn:hover {
    transform: translateY(-1px);
    background: rgba(0, 0, 0, 0.06);
    border-color: rgba(0, 0, 0, 0.18);
  }

  .link-primary {
    color: var(--c-text);
    background: rgba(0, 0, 0, 0.06);
    border: 1px solid rgba(0, 0, 0, 0.14);
  }

  .link-primary:hover {
    background: rgba(0, 0, 0, 0.08);
    border-color: rgba(0, 0, 0, 0.18);
  }

  .meta {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
    color: var(--c-muted);
    font-size: 0.86rem;
  }

  .dot {
    margin: 0 0.15rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.04);
    border: 1px solid rgba(0, 0, 0, 0.08);
    color: var(--c-muted);
    font-size: 0.78rem;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .project-card {
      padding: 1.25rem;
    }

    .header {
      flex-direction: column;
      align-items: flex-start;
    }

    .title-row {
      flex-direction: column;
      gap: 0.35rem;
    }

    .title {
      font-size: 1.18rem;
    }
  }
</style>
