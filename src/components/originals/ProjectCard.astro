---
import type { CollectionEntry } from "astro:content";

type Props = {
  post: CollectionEntry<"originals">;
};

const { post } = Astro.props;

const pickStatus = (tags: string[]): "done" | "wip" | undefined => {
  const lowered = tags.map((t) => t.toLowerCase());
  if (
    lowered.some(
      (t) =>
        t === "wip" ||
        t === "todo" ||
        t.includes("进行中") ||
        t.includes("开发中"),
    )
  )
    return "wip";
  if (
    lowered.some(
      (t) =>
        t === "done" ||
        t.includes("已上线") ||
        t.includes("完成") ||
        t.includes("发布"),
    )
  )
    return "done";
  return undefined;
};

const status = pickStatus(post.data.tags);
const description = post.data.description;
const githubUrl = post.data.githubUrl;
const demoUrl = post.data.demoUrl;
const displayStatus = post.data.status ?? status;

const displayTags = post.data.tags.filter((t) => {
  const lowered = t.toLowerCase();
  return lowered !== "wip" && lowered !== "todo" && lowered !== "done";
});
---

<article class="project-card">
  <header class="header">
    <div class="title-row">
      <h2 class="title">
        <a class="title-link" href={`/originals/${post.slug}`}
          >{post.data.title}</a
        >
      </h2>
      {post.data.featured && <span class="badge">推荐</span>}
    </div>

    {
      displayStatus && (
        <span class={`status status-${displayStatus}`}>
          {displayStatus === "done" ? "Done" : "WIP"}
        </span>
      )
    }
  </header>

  <div class="fields">
    {
      description && (
        <div class="field">
          <div class="label">简介</div>
          <div class="value">{description}</div>
        </div>
      )
    }
  </div>

  <footer class="footer">
    <div class="meta">
      <time datetime={post.data.pubDate.toISOString()}>
        {
          post.data.pubDate.toLocaleDateString("zh-CN", {
            year: "numeric",
            month: "2-digit",
            day: "2-digit",
          })
        }
      </time>
      {post.data.readingTime && <span class="dot">·</span>}
      {post.data.readingTime && <span>{post.data.readingTime} min read</span>}
    </div>

    {
      displayTags.length > 0 && (
        <div class="tags" aria-label="Tech Stack">
          {displayTags.slice(0, 6).map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )
    }

    {
      (githubUrl || demoUrl) && (
        <div class="links" aria-label="Project Links">
          {githubUrl && (
            <a
              class="link-btn"
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub
            </a>
          )}
          {demoUrl && (
            <a
              class="link-btn link-primary"
              href={demoUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Demo
            </a>
          )}
        </div>
      )
    }
  </footer>
</article>

<style>
  .project-card {
    background: var(--bg-card, #ffffff);
    border: 1px solid var(--border-color, #e5e7eb);
    border-radius: 14px;
    padding: 1.5rem 1.6rem;
    transition: all 0.2s ease;
  }

  .project-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 18px rgba(0, 0, 0, 0.06);
    border-color: rgba(79, 172, 254, 0.7);
  }

  .header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .title-row {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    flex: 1;
  }

  .title {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 650;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .title-link {
    color: var(--text-primary, #1f2937);
    text-decoration: none;
  }

  .title-link:hover {
    color: #4facfe;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
    color: #ffffff;
    background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
    white-space: nowrap;
  }

  .status {
    display: inline-flex;
    align-items: center;
    height: 28px;
    padding: 0 0.7rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .status-done {
    color: #065f46;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.25);
  }

  .status-wip {
    color: #7c2d12;
    background: rgba(251, 146, 60, 0.14);
    border: 1px solid rgba(251, 146, 60, 0.28);
  }

  .fields {
    margin-top: 0.95rem;
    display: grid;
    gap: 0.85rem;
  }

  .field {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 0.85rem;
    align-items: baseline;
  }

  .label {
    color: var(--text-tertiary, #9ca3af);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .value {
    color: var(--text-primary, #1f2937);
    line-height: 1.8;
    font-size: 0.98rem;
  }

  .footer {
    margin-top: 1rem;
    display: grid;
    gap: 0.75rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .link-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 34px;
    padding: 0 0.85rem;
    border-radius: 10px;
    font-size: 0.86rem;
    font-weight: 650;
    text-decoration: none;
    color: var(--text-primary, #1f2937);
    background: rgba(79, 172, 254, 0.08);
    border: 1px solid rgba(79, 172, 254, 0.18);
    transition: all 0.15s ease;
  }

  .link-btn:hover {
    transform: translateY(-1px);
    background: rgba(79, 172, 254, 0.12);
    border-color: rgba(79, 172, 254, 0.28);
  }

  .link-primary {
    color: #ffffff;
    background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
    border: 1px solid rgba(79, 172, 254, 0.35);
  }

  .link-primary:hover {
    background: linear-gradient(135deg, #3a9af0 0%, #00dfe9 100%);
    border-color: rgba(79, 172, 254, 0.5);
  }

  .meta {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
    color: var(--text-tertiary, #9ca3af);
    font-size: 0.86rem;
  }

  .dot {
    margin: 0 0.15rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
    background: rgba(79, 172, 254, 0.1);
    border: 1px solid rgba(79, 172, 254, 0.16);
    color: var(--text-secondary, #6b7280);
    font-size: 0.78rem;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .project-card {
      padding: 1.25rem;
    }

    .header {
      flex-direction: column;
      align-items: flex-start;
    }

    .title-row {
      flex-direction: column;
      gap: 0.35rem;
    }

    .title {
      font-size: 1.18rem;
    }

    .field {
      grid-template-columns: 48px 1fr;
    }
  }
</style>
