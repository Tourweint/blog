---
import type { CollectionEntry } from "astro:content";

type Props = {
  post: CollectionEntry<"originals">;
  maxChars?: number;
  listHref: string;
};

const { post, maxChars = 200, listHref } = Astro.props;

const sourceText = post.data.description ?? post.data.title;
const isShort = sourceText.length <= maxChars;
const displayText = isShort ? sourceText : `${sourceText.slice(0, maxChars)}…`;

const tagHref = (tag: string) => `${listHref}?tag=${encodeURIComponent(tag)}`;
---

<article
  class="fragment-card"
  data-originals-item
  data-tags={JSON.stringify(post.data.tags ?? [])}
>
  <a
    class="stretched-link"
    href={`/originals/${post.slug}`}
    aria-label={`打开片段：${post.data.title}`}
  >
  </a>
  <div class="content">{displayText}</div>

  <footer class="meta">
    <time datetime={post.data.pubDate.toISOString()}>
      {
        post.data.pubDate.toLocaleDateString("zh-CN", {
          year: "numeric",
          month: "2-digit",
          day: "2-digit",
        })
      }
    </time>

    {
      post.data.tags.length > 0 && (
        <span class="tags" aria-label="来源与标签">
          {post.data.tags.slice(0, 4).map((tag) => (
            <a
              class="tag"
              href={tagHref(tag)}
              data-originals-tag={tag}
              aria-label={`按标签筛选：${tag}`}
            >
              #{tag}
            </a>
          ))}
        </span>
      )
    }

    {!isShort && <span class="more">阅读全文 →</span>}
  </footer>
</article>

<style>
  .fragment-card {
    position: relative;
    display: block;
    text-decoration: none;
    background: var(--c-surface);
    border: 1px solid var(--c-rule);
    border-radius: var(--c-radius);
    padding: 1.25rem 1.35rem;
    box-shadow: var(--c-shadow);
    transition: all var(--c-dur) var(--c-ease);
  }

  .stretched-link {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    z-index: 2;
    display: block;
  }

  .stretched-link:focus-visible {
    outline: 3px solid var(--c-focus);
    outline-offset: 2px;
  }

  .fragment-card > :not(.stretched-link) {
    position: relative;
  }

  .fragment-card:hover {
    transform: translateY(-1px);
    box-shadow: var(--c-shadow-hover);
    border-color: rgba(0, 0, 0, 0.18);
  }

  .content {
    color: var(--c-text);
    line-height: 1.85;
    font-size: 1rem;
    white-space: pre-wrap;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.9rem;
    color: var(--c-muted);
    font-size: 0.86rem;
  }

  .tags {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    justify-content: flex-start;
  }

  .tag {
    position: relative;
    z-index: 3;
    color: var(--c-muted);
    background: rgba(0, 0, 0, 0.04);
    border: 1px solid rgba(0, 0, 0, 0.08);
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    font-size: 0.78rem;
    text-decoration: none;
    transition: all var(--c-dur) var(--c-ease);
  }

  .tag:hover {
    color: var(--c-text);
    border-color: rgba(0, 0, 0, 0.16);
  }

  .tag:focus-visible {
    outline: 3px solid var(--c-focus);
    outline-offset: 2px;
  }

  .more {
    color: var(--c-text);
    font-weight: 600;
    white-space: nowrap;
  }
</style>
