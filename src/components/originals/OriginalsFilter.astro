---
export type OriginalsActiveTab = "systems" | "fragments" | "projects";

type Props = {
  active: OriginalsActiveTab;
  counts: {
    systems: number;
    fragments: number;
    projects: number;
  };
};

const { active, counts } = Astro.props;

const tabs: Array<{
  key: OriginalsActiveTab;
  label: string;
  href: string;
  count: number;
}> = [
  {
    key: "systems",
    label: "原论",
    href: "/originals/systems/systems",
    count: counts.systems,
  },
  {
    key: "fragments",
    label: "原点",
    href: "/originals/fragments/fragments",
    count: counts.fragments,
  },
  {
    key: "projects",
    label: "原型",
    href: "/originals/projects/projects",
    count: counts.projects,
  },
];
---

<nav class="originals-filter" aria-label="原创内容过滤器">
  <a class="back-link" href="/originals">← 回到原触发</a>
  <div class="pills" role="tablist" aria-label="分类">
    {
      tabs.map((tab) => (
        <a
          class={`pill ${tab.key === active ? "is-active" : ""}`}
          href={tab.href}
          role="tab"
          aria-selected={tab.key === active ? "true" : "false"}
        >
          <span class="pill-label">{tab.label}</span>
          <span class="pill-count">{tab.count}</span>
        </a>
      ))
    }
  </div>
</nav>

<style>
  .originals-filter {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 1.25rem 0 1.75rem;
  }

  .back-link {
    color: var(--text-tertiary, #9ca3af);
    text-decoration: none;
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .back-link:hover {
    color: var(--text-secondary, #6b7280);
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--border-color, #e5e7eb);
    background: var(--bg-card, #ffffff);
    color: var(--text-secondary, #6b7280);
    text-decoration: none;
    font-size: 0.9rem;
    transition: all 0.2s ease;
  }

  .pill:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.06);
    color: var(--text-primary, #1f2937);
  }

  .pill.is-active {
    color: var(--text-primary, #1f2937);
    border-color: rgba(31, 41, 55, 0.2);
    background: var(--bg-subtle, #f9fafb);
  }

  .pill-count {
    color: var(--text-tertiary, #9ca3af);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 768px) {
    .originals-filter {
      flex-direction: column;
      align-items: stretch;
    }

    .back-link {
      text-align: center;
    }

    .pills {
      justify-content: center;
    }
  }
</style>
