---
import type { CollectionEntry } from "astro:content";
import { excerpts, toIdSlug } from "../utils/excerptsPaths";

interface Props {
  person: CollectionEntry<"persons">;
}

const { person } = Astro.props;
const { data } = person;
const personSlug = toIdSlug(person.id);
const personHref = excerpts.personDetail(personSlug);
---

<div class="person-card-mini">
  {
    data.avatar && (
      <img
        src={data.avatar}
        alt={data.name}
        class="mini-avatar"
        loading="lazy"
      />
    )
  }
  <div class="mini-info">
    <h4 class="mini-name">{data.name}</h4>
    {data.role && <p class="mini-role">{data.role}</p>}
    {data.bio && <p class="mini-bio">{data.bio}</p>}
    <a href={personHref} class="mini-link"> 查看详情 → </a>
  </div>
</div>

<style>
  .person-card-mini {
    display: flex;
    gap: 0.75rem;
    padding: 0 0 1.2rem;
    background: none;
    border: 0;
    border-radius: 0;
    margin-bottom: 1.2rem;
    box-shadow: none;
    position: relative;
    transition: none;
  }

  /* 多位嘉宾之间：32px 居中短横线 */
  .person-card-mini:not(:last-child)::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    width: 32px;
    height: 1px;
    background: rgba(0, 0, 0, 0.15);
  }

  .person-card-mini:last-child {
    padding-bottom: 0;
    margin-bottom: 0;
  }

  .mini-avatar {
    flex-shrink: 0;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    object-fit: cover;
    background: color-mix(in oklab, var(--c-text) 6%, transparent);
  }

  .mini-info {
    flex: 1;
    min-width: 0;
  }

  .mini-name {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--c-text);
    font-family: var(--t-font-serif);
  }

  .mini-role {
    margin: 0.2rem 0 0;
    font-size: 0.8rem;
    color: var(--c-muted);
  }

  .mini-bio {
    margin: 0.4rem 0 0;
    font-size: 0.8rem;
    color: var(--c-muted);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .mini-link {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.8rem;
    color: var(--t-link);
    text-decoration: none;
    font-weight: 500;
  }

  .mini-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .mini-link:focus-visible {
    outline: 3px solid var(--c-focus);
    outline-offset: 2px;
    border-radius: 4px;
  }
</style>
