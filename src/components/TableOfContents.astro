---
// 文章目录组件 - 用于长文导航
// mobile=true 时渲染为文章顶部的折叠式目录（窄屏使用）
export interface Props {
  headings: {
    depth: number;
    slug: string;
    text: string;
  }[];
  mobile?: boolean;
}

const { headings, mobile = false } = Astro.props;

// 只显示 h2 和 h3 级别的标题
const filteredHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{
  filteredHeadings.length > 0 && !mobile && (
    <aside class="toc-container" id="toc">
      <div class="toc-header">
        <span class="toc-title">目 录</span>
      </div>
      <nav class="toc-nav">
        <ul class="toc-list">
          {filteredHeadings.map((heading) => (
            <li class={`toc-item toc-item-h${heading.depth}`}>
              <a
                href={`#${heading.slug}`}
                class="toc-link"
                data-slug={heading.slug}
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>
  )
}

{
  filteredHeadings.length > 0 && mobile && (
    <details class="toc-container toc-container--mobile">
      <summary class="toc-mobile-summary">
        <span class="toc-title">目 录</span>
      </summary>
      <nav class="toc-nav">
        <ul class="toc-list">
          {filteredHeadings.map((heading) => (
            <li class={`toc-item toc-item-h${heading.depth}`}>
              <a
                href={`#${heading.slug}`}
                class="toc-link"
                data-slug={heading.slug}
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  )
}

<script>
  // 目录高亮和滚动监听
  document.addEventListener("DOMContentLoaded", () => {
    const tocLinks = document.querySelectorAll(".toc-link");
    const headings = document.querySelectorAll(".content h2, .content h3");

    if (tocLinks.length === 0 || headings.length === 0) return;

    // 点击平滑滚动
    tocLinks.forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault();
        const targetId = link.getAttribute("href")?.slice(1);
        const targetElement = document.getElementById(targetId || "");
        if (targetElement) {
          // 与全局 --nav-height 保持一致（桌面 64px / 移动 56px）
          const navHeight =
            parseFloat(
              getComputedStyle(document.documentElement)
                .getPropertyValue("--nav-height")
                .trim(),
            ) || 64;
          const targetPosition = targetElement.offsetTop - navHeight - 20;
          window.scrollTo({
            top: targetPosition,
            behavior: "smooth",
          });

          // 窄屏折叠目录：跳转后收起
          const mobileToc = link.closest(
            "details.toc-container--mobile",
          ) as HTMLDetailsElement | null;
          if (mobileToc) mobileToc.open = false;
        }
      });
    });

    // 滚动时高亮当前章节
    const observerOptions = {
      root: null,
      rootMargin: "-80px 0px -70% 0px",
      threshold: 0,
    };

    let currentActiveLink: Element | null = null;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute("id");
          const correspondingLink = document.querySelector(
            `.toc-link[data-slug="${id}"]`,
          );

          if (currentActiveLink) {
            currentActiveLink.classList.remove("active");
          }

          if (correspondingLink) {
            correspondingLink.classList.add("active");
            currentActiveLink = correspondingLink;

            // 确保当前高亮项在可视区域内
            const tocNav = document.querySelector(".toc-nav");
            if (tocNav && correspondingLink) {
              const linkRect = correspondingLink.getBoundingClientRect();
              const navRect = tocNav.getBoundingClientRect();

              if (
                linkRect.top < navRect.top ||
                linkRect.bottom > navRect.bottom
              ) {
                correspondingLink.scrollIntoView({
                  block: "nearest",
                  behavior: "smooth",
                });
              }
            }
          }
        }
      });
    }, observerOptions);

    headings.forEach((heading) => observer.observe(heading));

    // 初始化：高亮第一个可见标题
    const firstHeading = headings[0];
    if (firstHeading) {
      const id = firstHeading.getAttribute("id");
      const firstLink = document.querySelector(`.toc-link[data-slug="${id}"]`);
      if (firstLink) {
        firstLink.classList.add("active");
        currentActiveLink = firstLink;
      }
    }
  });
</script>

<style>
  .toc-container {
    width: 100%;
    background: transparent;
    border-radius: 0;
    border: 0;
    box-shadow: none;
    overflow: visible;
    display: flex;
    flex-direction: column;
  }

  .toc-header {
    display: flex;
    align-items: center;
    padding: 14px 18px 12px;
    border-bottom: 1px solid var(--c-rule);
    background: transparent;
  }

  .toc-title {
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--c-text);
    font-family: var(--t-font-serif);
    letter-spacing: 0.24em; /* 刊头式宽字距 */
  }

  .toc-nav {
    overflow-y: auto;
    padding: 12px 0;
    scrollbar-width: thin;
    scrollbar-color: rgba(0, 0, 0, 0.18) transparent;
  }

  .toc-nav::-webkit-scrollbar {
    width: 4px;
  }

  .toc-nav::-webkit-scrollbar-track {
    background: transparent;
  }

  .toc-nav::-webkit-scrollbar-thumb {
    background-color: rgba(0, 0, 0, 0.18);
    border-radius: 4px;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-item {
    margin: 0;
  }

  .toc-item-h2 {
    /* H2 级别 */
  }

  .toc-item-h3 {
    /* H3 级别，缩进 */
  }

  .toc-item-h3 .toc-link {
    padding-left: 28px;
    font-size: 0.85rem;
  }

  .toc-link {
    display: block;
    padding: 8px 18px;
    font-size: 0.9rem;
    color: var(--c-muted);
    text-decoration: none;
    border-left: 3px solid transparent;
    transition: all var(--c-dur) var(--c-ease);
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .toc-link:hover {
    color: var(--c-text);
    background: rgba(0, 0, 0, 0.03);
    border-left-color: rgba(0, 0, 0, 0.18);
  }

  .toc-link:focus-visible {
    outline: 3px solid var(--c-focus);
    outline-offset: 2px;
    border-left-color: rgba(0, 0, 0, 0.18);
  }

  .toc-link.active {
    color: var(--t-link);
    background: color-mix(in oklab, var(--t-link) 6%, transparent);
    border-left-color: color-mix(in oklab, var(--t-link) 60%, transparent);
    font-weight: 600;
  }

  /* 桌面侧栏目录：窄屏隐藏，由正文内折叠目录取代 */
  @media (max-width: 1200px) {
    .toc-container:not(.toc-container--mobile) {
      display: none;
    }
  }

  /* ===== 窄屏折叠式目录 ===== */
  .toc-container--mobile {
    display: none;
  }

  @media (max-width: 1200px) {
    .toc-container--mobile {
      display: block;
      margin: 2px 0 20px;
      background: transparent;
      border: 0;
      border-top: 1px solid var(--c-rule);
      border-bottom: 1px solid var(--c-rule);
      border-radius: 0;
      box-shadow: none;
      overflow: visible;
    }

    .toc-mobile-summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 11px 2px;
      cursor: pointer;
      list-style: none;
      user-select: none;
    }

    .toc-mobile-summary::-webkit-details-marker {
      display: none;
    }

    .toc-mobile-summary .toc-title {
      font-size: 0.85rem;
      letter-spacing: 0.24em;
      color: var(--c-text);
    }

    .toc-mobile-summary::after {
      content: "+";
      font-size: 1.15rem;
      line-height: 1;
      font-weight: 400;
      color: var(--c-muted);
      transition: transform var(--c-dur) var(--c-ease);
    }

    .toc-container--mobile[open] .toc-mobile-summary {
      border-bottom: 1px solid var(--c-rule);
    }

    .toc-container--mobile[open] .toc-mobile-summary::after {
      content: "\2212"; /* − */
    }

    .toc-container--mobile .toc-nav {
      padding: 6px 0 8px;
      max-height: 48vh;
      overflow-y: auto;
      border-left: 0;
    }

    .toc-container--mobile .toc-link {
      padding: 9px 8px 9px 10px;
      font-size: 0.88rem;
    }

    .toc-container--mobile .toc-item-h3 .toc-link {
      padding-left: 26px;
      font-size: 0.85rem;
    }
  }
</style>
