---
// 文章目录组件 - 用于长文导航
export interface Props {
  headings: {
    depth: number;
    slug: string;
    text: string;
  }[];
}

const { headings } = Astro.props;

// 只显示 h2 和 h3 级别的标题
const filteredHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{
  filteredHeadings.length > 0 && (
    <aside class="toc-container" id="toc">
      <div class="toc-header">
        <span class="toc-icon">📑</span>
        <span class="toc-title">目录</span>
      </div>
      <nav class="toc-nav">
        <ul class="toc-list">
          {filteredHeadings.map((heading) => (
            <li class={`toc-item toc-item-h${heading.depth}`}>
              <a
                href={`#${heading.slug}`}
                class="toc-link"
                data-slug={heading.slug}
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>
  )
}

<script>
  // 目录高亮和滚动监听
  document.addEventListener("DOMContentLoaded", () => {
    const tocLinks = document.querySelectorAll(".toc-link");
    const headings = document.querySelectorAll(".content h2, .content h3");

    if (tocLinks.length === 0 || headings.length === 0) return;

    // 点击平滑滚动
    tocLinks.forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault();
        const targetId = link.getAttribute("href")?.slice(1);
        const targetElement = document.getElementById(targetId || "");
        if (targetElement) {
          const navHeight = 70; // 导航栏高度
          const targetPosition = targetElement.offsetTop - navHeight - 20;
          window.scrollTo({
            top: targetPosition,
            behavior: "smooth",
          });
        }
      });
    });

    // 滚动时高亮当前章节
    const observerOptions = {
      root: null,
      rootMargin: "-80px 0px -70% 0px",
      threshold: 0,
    };

    let currentActiveLink: Element | null = null;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute("id");
          const correspondingLink = document.querySelector(
            `.toc-link[data-slug="${id}"]`,
          );

          if (currentActiveLink) {
            currentActiveLink.classList.remove("active");
          }

          if (correspondingLink) {
            correspondingLink.classList.add("active");
            currentActiveLink = correspondingLink;

            // 确保当前高亮项在可视区域内
            const tocNav = document.querySelector(".toc-nav");
            if (tocNav && correspondingLink) {
              const linkRect = correspondingLink.getBoundingClientRect();
              const navRect = tocNav.getBoundingClientRect();

              if (
                linkRect.top < navRect.top ||
                linkRect.bottom > navRect.bottom
              ) {
                correspondingLink.scrollIntoView({
                  block: "nearest",
                  behavior: "smooth",
                });
              }
            }
          }
        }
      });
    }, observerOptions);

    headings.forEach((heading) => observer.observe(heading));

    // 初始化：高亮第一个可见标题
    const firstHeading = headings[0];
    if (firstHeading) {
      const id = firstHeading.getAttribute("id");
      const firstLink = document.querySelector(`.toc-link[data-slug="${id}"]`);
      if (firstLink) {
        firstLink.classList.add("active");
        currentActiveLink = firstLink;
      }
    }
  });
</script>

<style>
  .toc-container {
    width: 100%;
    background: var(--c-surface);
    border-radius: var(--c-radius);
    border: 1px solid var(--c-rule);
    box-shadow: var(--c-shadow);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .toc-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 14px 18px 10px;
    background: transparent;
  }

  .toc-icon {
    font-size: 1.1rem;
  }

  .toc-title {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--c-text);
    font-family: var(--t-font-serif);
    letter-spacing: 0.06em; /* 轻微字距提升层级感 */
  }

  .toc-nav {
    overflow-y: auto;
    padding: 12px 0;
    scrollbar-width: thin;
    scrollbar-color: rgba(0, 0, 0, 0.18) transparent;
  }

  .toc-nav::-webkit-scrollbar {
    width: 4px;
  }

  .toc-nav::-webkit-scrollbar-track {
    background: transparent;
  }

  .toc-nav::-webkit-scrollbar-thumb {
    background-color: rgba(0, 0, 0, 0.18);
    border-radius: 4px;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-item {
    margin: 0;
  }

  .toc-item-h2 {
    /* H2 级别 */
  }

  .toc-item-h3 {
    /* H3 级别，缩进 */
  }

  .toc-item-h3 .toc-link {
    padding-left: 28px;
    font-size: 0.85rem;
  }

  .toc-link {
    display: block;
    padding: 8px 18px;
    font-size: 0.9rem;
    color: var(--c-muted);
    text-decoration: none;
    border-left: 3px solid transparent;
    transition: all var(--c-dur) var(--c-ease);
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .toc-link:hover {
    color: var(--c-text);
    background: rgba(0, 0, 0, 0.03);
    border-left-color: rgba(0, 0, 0, 0.18);
  }

  .toc-link:focus-visible {
    outline: 3px solid var(--c-focus);
    outline-offset: 2px;
    border-left-color: rgba(0, 0, 0, 0.18);
  }

  .toc-link.active {
    color: var(--c-text);
    background: rgba(0, 0, 0, 0.04);
    border-left-color: rgba(0, 0, 0, 0.28);
    font-weight: 600;
  }

  /* 移动端隐藏目录 */
  @media (max-width: 1200px) {
    .toc-container {
      display: none;
    }
  }
</style>
