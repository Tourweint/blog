---
import type { CollectionEntry } from "astro:content";

interface Props {
  conversation: CollectionEntry<"conversations">;
}

const { conversation } = Astro.props;
const { data, slug } = conversation;
const guestNames = data.guests.map((g) => g.name).join(" × ");
---

<article class="conversation-card">
  <!-- 卡片头部：嘉宾信息 -->
  <div class="card-header">
    {
      data.guests[0]?.image && (
        <div class="guest-image">
          <img src={data.guests[0].image} alt={data.guests[0].name} />
        </div>
      )
    }
    <div class="header-content">
      <div class="participants">
        {
          data.interviewer && (
            <>
              <span class="role host">{data.interviewer}</span>
              <span class="separator">×</span>
            </>
          )
        }
        {
          guestNames
            .split(" × ")
            .map((name) => <span class="role guest">{name}</span>)
        }
      </div>
      <p class="source-badge">{data.source}</p>
    </div>
  </div>

  <!-- 卡片主体：标题和金句 -->
  <div class="card-body">
    <h3 class="conversation-title">
      <a href={`/conversations/${slug}`}>{data.title}</a>
    </h3>

    {
      data.pullQuote && (
        <blockquote class="pull-quote">
          <svg class="quote-icon" viewBox="0 0 24 24" fill="currentColor">
            <path d="M3 21c3 0 7-1 7-8V5c0-1.25-4.25-2.5-7-2.5S0 3.75 0 5c0 5 0 7 1 14s2 8 5 8z" />
          </svg>
          <p>{data.pullQuote}</p>
        </blockquote>
      )
    }

    {data.description && <p class="description">{data.description}</p>}
  </div>

  <!-- 卡片底部：元数据 -->
  <div class="card-footer">
    <div class="meta">
      {
        data.readingTime && (
          <span class="reading-time">
            <svg class="icon" viewBox="0 0 24 24" fill="currentColor">
              <circle
                cx="12"
                cy="12"
                r="10"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              />
              <polyline
                points="12 6 12 12 16 14"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              />
            </svg>
            {data.readingTime} min
          </span>
        )
      }
      <span class="pub-date">
        {
          new Date(data.pubDate).toLocaleDateString("zh-CN", {
            year: "numeric",
            month: "short",
            day: "numeric",
          })
        }
      </span>
    </div>
    {
      data.tags && data.tags.length > 0 && (
        <div class="tags">
          {data.tags.slice(0, 3).map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )
    }
  </div>

  <a href={`/conversations/${slug}`} class="card-link"></a>
</article>

<style>
  .conversation-card {
    position: relative;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .conversation-card:hover {
    border-color: rgba(154, 107, 47, 0.4);
    box-shadow: 0 10px 26px rgba(154, 107, 47, 0.12);
    transform: translateY(-2px);
  }

  .card-header {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.5rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .guest-image {
    flex-shrink: 0;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--color-bg-tertiary);
  }

  .guest-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .header-content {
    flex: 1;
    min-width: 0;
  }

  .participants {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .role {
    padding: 0.25rem 0.75rem;
    border-radius: 16px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .role.host {
    background: rgba(154, 107, 47, 0.12);
    color: #9a6b2f;
  }

  .role.guest {
    background: rgba(238, 242, 247, 0.8);
    color: #5a6b7d;
  }

  .separator {
    color: var(--color-text-tertiary);
    font-weight: normal;
  }

  .source-badge {
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    margin: 0;
    font-weight: 500;
  }

  .card-body {
    padding: 1.5rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .conversation-title {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.4;
    color: var(--color-text);
  }

  .conversation-title a {
    color: inherit;
    text-decoration: none;
  }

  .conversation-title a:hover {
    color: #9a6b2f;
  }

  .pull-quote {
    margin: 0;
    padding: 1rem;
    background: rgba(248, 244, 236, 0.5);
    border-left: 3px solid rgba(154, 107, 47, 0.4);
    border-radius: 4px;
    font-style: italic;
    color: var(--color-text-secondary);
    position: relative;
  }

  .pull-quote p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .quote-icon {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    width: 20px;
    height: 20px;
    opacity: 0.3;
  }

  .description {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    padding: 1rem 1.5rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.85rem;
    color: var(--color-text-tertiary);
  }

  .reading-time {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .icon {
    width: 16px;
    height: 16px;
  }

  .pub-date {
    font-weight: 500;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    display: inline-block;
    padding: 0.25rem 0.6rem;
    background: rgba(238, 242, 247, 0.6);
    color: #5a6b7d;
    border-radius: 12px;
    font-size: 0.8rem;
    font-weight: 500;
  }

  .card-link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  @media (max-width: 640px) {
    .card-header {
      padding: 1rem;
      gap: 0.75rem;
    }

    .guest-image {
      width: 50px;
      height: 50px;
    }

    .participants {
      font-size: 0.85rem;
    }

    .card-body {
      padding: 1rem;
      gap: 0.75rem;
    }

    .conversation-title {
      font-size: 1.1rem;
    }

    .card-footer {
      padding: 0.75rem 1rem;
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
