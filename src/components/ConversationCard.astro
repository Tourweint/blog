---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import { excerpts, toIdSlug } from "../utils/excerptsPaths";

interface Props {
  conversation: CollectionEntry<"conversations">;
}

const { conversation } = Astro.props;
const { data } = conversation;
const conversationHref = excerpts.conversationDetail(
  toIdSlug(conversation.id),
);

// 通过 slug 查找人物信息；查不到时回退用 slug 本身（否则该嘉宾会从姓名行消失）
const allPersons = await getCollection("persons");
const guests = (data.guests ?? []).map((slug) => {
  const person = allPersons.find((p) => toIdSlug(p.id) === slug);
  return { name: person?.data.name ?? slug, avatar: person?.data.avatar };
});

/*
  头像：只取有 avatar 的嘉宾，缺图的人直接跳过（不占位）。
  单嘉宾 40px 贴右上角；多嘉宾 32px 并排、互相叠压 10px；
  超过 3 位时第三枚位置换成「+N」，避免头像组无限变宽。
*/
const avatars = guests
  .map((guest) => guest.avatar)
  .filter((src): src is string => Boolean(src));
const MAX_AVATARS = 3;
const visibleAvatars = avatars.slice(0, MAX_AVATARS);
const hiddenAvatarCount = avatars.length - visibleAvatars.length;
const isMulti = avatars.length > 1;

// 标题与署名给头像留出的右侧空间（无头像时不留白）
const reserve =
  avatars.length === 0
    ? 0
    : avatars.length === 1
      ? 52
      : 20 + 32 * visibleAvatars.length - 10 * (visibleAvatars.length - 1);

// 没有金句时退回摘要；已有的引号不再重复包裹
const rawQuote = data.pullQuote ?? data.description ?? null;
const quoteText = rawQuote
  ? /^[「“"]/.test(rawQuote)
    ? rawQuote
    : `「${rawQuote}」`
  : null;

const published = new Date(data.pubDate);
const dateLabel = [
  published.getFullYear(),
  String(published.getMonth() + 1).padStart(2, "0"),
  String(published.getDate()).padStart(2, "0"),
].join(".");
---

<article
  class="conversation-card"
  style={`--avatar-reserve: ${reserve}px`}
>
  <a class="conversation-card__hit" href={conversationHref} aria-label={data.title}>
    {
      visibleAvatars.length > 0 && (
        <div
          class:list={["conversation-card__avatars", { "is-multi": isMulti }]}
          aria-hidden="true"
        >
          {visibleAvatars.map((src) => (
            <img src={src} alt="" loading="lazy" />
          ))}
          {hiddenAvatarCount > 0 && (
            <span class="avatar-more">+{hiddenAvatarCount}</span>
          )}
        </div>
      )
    }

    <p class="conversation-card__who">
      {
        data.interviewer && (
          <>
            <span class="p-host">{data.interviewer}</span>
            <span class="p-sep">×</span>
          </>
        )
      }
      {
        guests.map((guest, index) => (
          <>
            {index > 0 && <span class="p-sep">×</span>}
            <span class="p-guest">{guest.name}</span>
          </>
        ))
      }
    </p>

    <h3 class="conversation-card__title">{data.title}</h3>

    {quoteText && <p class="conversation-card__quote">{quoteText}</p>}

    <p class="conversation-card__meta">
      {data.source && <span>{data.source}</span>}
      {data.readingTime && <span>{data.readingTime} 分钟</span>}
      <span>{dateLabel}</span>
    </p>
  </a>
</article>

<style>
  /*
    对话卡：右上角嘉宾头像（单枚 / 叠压并排）+ 署名眉标 / 19px 标题 /
    一行金句 / 一行出处。标签与内部分割线不进卡片，金句留给详情页。
  */
  .conversation-card {
    position: relative;
    height: 100%;
    background: var(--c-surface);
    border: 1px solid var(--c-rule);
    border-radius: var(--c-radius);
    box-shadow: var(--c-shadow);
    transition:
      transform var(--c-dur) var(--c-ease),
      border-color var(--c-dur) var(--c-ease),
      box-shadow var(--c-dur) var(--c-ease);
  }

  .conversation-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--c-rule) 180%, transparent);
    box-shadow: var(--c-shadow-hover);
  }

  .conversation-card__hit {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 190px;
    padding: 20px 22px;
    border-radius: inherit;
    color: inherit;
    text-decoration: none;
  }

  /* ===== 头像：单枚 40px / 多枚 32px 叠压 ===== */
  .conversation-card__avatars {
    position: absolute;
    top: 18px;
    right: 18px;
    display: flex;
    align-items: center;
    z-index: 1;
  }

  .conversation-card__avatars img {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    background: color-mix(in oklab, var(--c-text) 8%, transparent);
    border: 1px solid color-mix(in oklab, var(--c-rule) 140%, transparent);
  }

  .conversation-card__avatars.is-multi {
    top: 20px;
  }

  .conversation-card__avatars.is-multi img {
    width: 32px;
    height: 32px;
    border: 2px solid var(--c-surface);
  }

  .conversation-card__avatars.is-multi img + img,
  .conversation-card__avatars.is-multi img + .avatar-more {
    margin-left: -10px;
  }

  .avatar-more {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 2px solid var(--c-surface);
    background: color-mix(in oklab, var(--c-text) 78%, var(--c-surface));
    color: var(--c-surface);
    font-size: 10px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  /* ===== 文字 ===== */
  /* 多嘉宾时署名会变长，放开到两行，避免名字被单行截断 */
  .conversation-card__who {
    margin: 0;
    padding-right: var(--avatar-reserve, 0);
    font-size: 11.5px;
    font-weight: 500;
    line-height: 1.55;
    letter-spacing: 0.03em;
    color: var(--c-muted);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }

  .p-host {
    color: var(--c-text);
  }

  .p-sep {
    margin: 0 5px;
    opacity: 0.6;
  }

  .conversation-card__title {
    margin: 10px 0 0;
    padding-right: var(--avatar-reserve, 0);
    font-family: var(--t-font-serif);
    font-size: 19px;
    font-weight: 700;
    line-height: 1.42;
    letter-spacing: 0.01em;
    color: var(--c-text);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    overflow-wrap: anywhere;
  }

  .conversation-card__quote {
    margin: 10px 0 0;
    font-family: var(--t-font-serif);
    font-size: 12.5px;
    line-height: 1.7;
    color: var(--c-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .conversation-card__meta {
    margin: auto 0 0;
    padding-top: 14px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    font-size: 11.5px;
    line-height: 1.6;
    color: var(--c-muted);
    font-variant-numeric: tabular-nums;
  }

  .conversation-card__meta span + span::before {
    content: "·";
    margin: 0 6px;
    opacity: 0.55;
  }

  @media (max-width: 480px) {
    .conversation-card__hit {
      padding: 18px;
    }

    .conversation-card__avatars {
      top: 16px;
      right: 16px;
    }

    .conversation-card__avatars.is-multi {
      top: 18px;
    }
  }
</style>
