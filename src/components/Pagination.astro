---
interface Props {
  currentPage: number;
  totalPages: number;
  getPageUrl: (page: number) => string;
}

const { currentPage, totalPages, getPageUrl } = Astro.props;

// 生成要显示的页码数组
function generatePageNumbers(
  current: number,
  total: number,
): (number | "...")[] {
  const pages: (number | "...")[] = [];

  if (total <= 7) {
    // 总页数少于等于7页，全部显示
    for (let i = 1; i <= total; i++) {
      pages.push(i);
    }
  } else {
    // 始终显示第一页
    pages.push(1);

    if (current <= 4) {
      // 当前页靠近开头: 1 2 3 4 5 ... 10
      for (let i = 2; i <= 5; i++) {
        pages.push(i);
      }
      pages.push("...");
      pages.push(total);
    } else if (current >= total - 3) {
      // 当前页靠近结尾: 1 ... 6 7 8 9 10
      pages.push("...");
      for (let i = total - 4; i <= total; i++) {
        pages.push(i);
      }
    } else {
      // 当前页在中间: 1 ... 4 5 6 ... 10
      pages.push("...");
      for (let i = current - 1; i <= current + 1; i++) {
        pages.push(i);
      }
      pages.push("...");
      pages.push(total);
    }
  }

  return pages;
}

const pageNumbers = generatePageNumbers(currentPage, totalPages);
const prevUrl = currentPage > 1 ? getPageUrl(currentPage - 1) : null;
const nextUrl = currentPage < totalPages ? getPageUrl(currentPage + 1) : null;
---

{
  totalPages > 1 && (
    <nav class="pagination-container" aria-label="分页导航">
      {/* 上一页按钮 */}
      <a
        href={prevUrl || "#"}
        class={`page-btn ${!prevUrl ? "disabled" : ""}`}
        aria-label="上一页"
        aria-disabled={!prevUrl}
      >
        ◀
      </a>

      {/* 页码 */}
      {pageNumbers.map((p) =>
        p === "..." ? (
          <span class="page-ellipsis">...</span>
        ) : (
          <a
            href={getPageUrl(p)}
            class={`page-btn ${p === currentPage ? "active" : ""}`}
            aria-label={`第${p}页`}
            aria-current={p === currentPage ? "page" : undefined}
          >
            {p}
          </a>
        ),
      )}

      {/* 下一页按钮 */}
      <a
        href={nextUrl || "#"}
        class={`page-btn ${!nextUrl ? "disabled" : ""}`}
        aria-label="下一页"
        aria-disabled={!nextUrl}
      >
        ▶
      </a>
    </nav>
  )
}

<style>
  .pagination-container {
    margin: 24px 0 48px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .page-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    height: 38px;
    padding: 0 12px;
    border: 1px solid var(--c-rule);
    background: var(--c-surface);
    color: var(--c-text);
    border-radius: 10px;
    cursor: pointer;
    font-size: 0.95rem;
    line-height: 1;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06);
    transition:
      transform var(--c-dur) var(--c-ease),
      box-shadow var(--c-dur) var(--c-ease),
      border-color var(--c-dur) var(--c-ease),
      background-color var(--c-dur) var(--c-ease);
    text-decoration: none;
  }

  .page-btn:hover:not([aria-disabled="true"]):not(.disabled):not(:disabled) {
    background: rgba(0, 0, 0, 0.02);
    border-color: rgba(0, 0, 0, 0.16);
    box-shadow: 0 6px 16px rgba(15, 23, 42, 0.08);
    transform: translateY(-1px);
  }

  .page-btn:active:not([aria-disabled="true"]):not(.disabled):not(:disabled) {
    transform: translateY(0);
  }

  .page-btn:focus-visible {
    outline: 3px solid var(--c-focus);
    outline-offset: 2px;
  }

  .page-btn:disabled,
  .page-btn.disabled,
  .page-btn[aria-disabled="true"] {
    color: rgba(0, 0, 0, 0.28);
    border-color: rgba(0, 0, 0, 0.08);
    background: rgba(255, 255, 255, 0.7);
    cursor: not-allowed;
    box-shadow: none;
    pointer-events: none;
  }

  .page-btn.active {
    border-color: rgba(0, 0, 0, 0.22);
    background: rgba(0, 0, 0, 0.04);
    font-weight: 650;
  }

  .page-ellipsis {
    color: var(--c-muted);
    padding: 0 4px;
    user-select: none;
  }
</style>
