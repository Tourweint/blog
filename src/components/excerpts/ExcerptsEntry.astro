---
/*
  摘录主页的栏目入口卡：英文眉标 + 栏目名 + 条目数 + 一句描述。
  与四个频道页的「频道条」共用同一套尺寸与圆角语言，
  但保持"入口"的权重：比频道条里的胶囊大，比文章卡轻。
*/
type Props = {
  href: string;
  /** 英文眉标（自动大写）：Posts / Notes / Persons / Conversations */
  label: string;
  name: string;
  count: number;
  /** 计数单位：篇 / 条 / 位 */
  unit: string;
  description: string;
};

const { href, label, name, count, unit, description } = Astro.props;
---

<a class="entry" href={href} aria-label={`前往：${name}（${count} ${unit}）`}>
  <span class="entry__label">{label}</span>
  <span class="entry__head">
    <span class="entry__name">{name}</span>
    <span class="entry__count">{count} {unit}</span>
  </span>
  <span class="entry__desc">{description}</span>
</a>

<style>
  .entry {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px 22px 18px;
    border: 1px solid var(--c-rule);
    border-radius: var(--c-radius);
    background: var(--c-surface);
    box-shadow: var(--c-shadow);
    text-decoration: none;
    color: inherit;
    transition:
      transform var(--c-dur) var(--c-ease),
      border-color var(--c-dur) var(--c-ease),
      background-color var(--c-dur) var(--c-ease),
      box-shadow var(--c-dur) var(--c-ease);
  }

  /* 悬浮时轻微上浮：与「原创」页的三张栏目卡同一套反馈 */
  .entry:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--c-rule) 180%, transparent);
    background: color-mix(in oklab, var(--c-text) 2%, var(--c-surface));
    box-shadow: var(--c-shadow-hover);
  }

  .entry:focus-visible {
    outline: 3px solid var(--c-focus);
    outline-offset: 3px;
  }

  .entry__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  /* 英文眉标：与 ChannelHero 的 eyebrow 同一套语言（12px / 大写 / 疏字距） */
  .entry__label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-muted);
    transition: color var(--c-dur) var(--c-ease);
  }

  .entry:hover .entry__label {
    color: var(--c-text);
  }

  .entry__name {
    font-family: var(--t-font-serif);
    font-size: 22px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.01em;
  }

  .entry__count {
    flex: 0 0 auto;
    font-size: 12.5px;
    color: var(--c-muted);
    font-variant-numeric: tabular-nums;
  }

  .entry__desc {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--c-muted);
  }
</style>
