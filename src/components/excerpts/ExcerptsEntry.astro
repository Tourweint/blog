---
/*
  摘录主页的栏目入口卡：栏目名 + 条目数 + 一句描述 + 浏览箭头。
  与四个频道页的「频道条」共用同一套尺寸与圆角语言，
  但保持"入口"的权重：比频道条里的胶囊大，比文章卡轻。
*/
type Props = {
  href: string;
  name: string;
  count: number;
  /** 计数单位：篇 / 条 / 位 */
  unit: string;
  description: string;
};

const { href, name, count, unit, description } = Astro.props;
---

<a class="entry" href={href} aria-label={`前往：${name}（${count} ${unit}）`}>
  <span class="entry__head">
    <span class="entry__name">{name}</span>
    <span class="entry__count">{count} {unit}</span>
  </span>
  <span class="entry__desc">{description}</span>
  <span class="entry__go">
    浏览
    <span class="entry__arrow" aria-hidden="true">→</span>
  </span>
</a>

<style>
  .entry {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px 22px 18px;
    border: 1px solid var(--c-rule);
    border-radius: var(--c-radius);
    background: var(--c-surface);
    box-shadow: var(--c-shadow);
    text-decoration: none;
    color: inherit;
    transition:
      border-color var(--c-dur) var(--c-ease),
      background-color var(--c-dur) var(--c-ease),
      box-shadow var(--c-dur) var(--c-ease);
  }

  .entry:hover {
    border-color: color-mix(in oklab, var(--c-rule) 180%, transparent);
    background: color-mix(in oklab, var(--c-text) 2%, var(--c-surface));
    box-shadow: var(--c-shadow-hover);
  }

  .entry:focus-visible {
    outline: 3px solid var(--c-focus);
    outline-offset: 3px;
  }

  .entry__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .entry__name {
    font-family: var(--t-font-serif);
    font-size: 22px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.01em;
  }

  .entry__count {
    flex: 0 0 auto;
    font-size: 12.5px;
    color: var(--c-muted);
    font-variant-numeric: tabular-nums;
  }

  .entry__desc {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--c-muted);
  }

  .entry__go {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: auto;
    padding-top: 4px;
    font-size: 12.5px;
    color: var(--c-muted);
    transition: color var(--c-dur) var(--c-ease);
  }

  .entry__arrow {
    display: inline-block;
    transition: transform var(--c-dur) var(--c-ease);
  }

  .entry:hover .entry__go {
    color: var(--c-text);
  }

  .entry:hover .entry__arrow {
    transform: translateX(3px);
  }
</style>
