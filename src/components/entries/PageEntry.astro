---
export interface Props {
  href: string;
  title: string;
  description?: string;
  eyebrow?: string;
  target?: "_self" | "_blank";
  rel?: string;
}

const {
  href,
  title,
  description,
  eyebrow,
  target = "_self",
  rel,
} = Astro.props;

const computedRel = target === "_blank" ? (rel ?? "noopener noreferrer") : rel;
---

<a
  class="page-entry"
  href={href}
  aria-label={`前往：${title}`}
  target={target}
  rel={computedRel}
>
  {eyebrow && <p class="page-entry__eyebrow">{eyebrow}</p>}
  <h3 class="page-entry__title">{title}</h3>
  {description && <p class="page-entry__desc">{description}</p>}
</a>

<style>
  .page-entry {
    display: block;
    text-decoration: none;
    color: inherit;
    padding: 14px 16px;
    border-radius: var(--c-radius);
    background: var(--c-surface);
    border: 1px solid var(--c-rule);
    box-shadow: var(--c-shadow);
    transition:
      transform var(--c-dur) var(--c-ease),
      box-shadow var(--c-dur) var(--c-ease),
      border-color var(--c-dur) var(--c-ease);
  }

  .page-entry:hover {
    transform: translateY(-1px);
    border-color: color-mix(in oklab, var(--c-rule) 65%, var(--c-text) 35%);
    box-shadow: var(--c-shadow-hover);
  }

  .page-entry:focus-visible {
    outline: 3px solid var(--c-focus);
    outline-offset: 3px;
  }

  .page-entry__eyebrow {
    margin: 0 0 6px;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-muted);
  }

  .page-entry__title {
    margin: 0;
    font-size: 16px;
    line-height: 1.25;
    font-family: var(--t-font-serif);
  }

  .page-entry__desc {
    margin: 8px 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--c-muted);
  }
</style>
